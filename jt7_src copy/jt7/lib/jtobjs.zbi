class GameStatic extends GameObject {
}

class Station extends GameStatic {
  native string property name get [calllink] set [calllink];
}

class RStation extends Station {
  native string property type get [calllink] set [calllink];
}

class RDepo extends RStation {
//  native Array property trains get;
//  native string property type get [calllink] set [calllink];
}

class Airport extends Station {
}

class Aircraft extends Mobile {
  native constructor (Airport start) [cmethod=newaircraft wantrt];
  native bool function goTo(Airport airport);
  native string property type get [calllink] set [calllink];
}

class BusStop extends Station {
  native string property type get [calllink] set [calllink];
}

class Motocar extends Mobile {
  native constructor () [cmethod=newmotocar wantrt];
  native bool function goTo(BusStop stop);
  native void function start(BusStop stop);
  native string property type get [calllink] set [calllink];
  
  ///ignorus nearest cross
  native void function ignore() [calllink cmethod=ignorecross];
  
  native string property state get [calllink cmethod=getstatestr];
  ///actual speed
  native float property speed get [calllink];
  ///releases motocar, if it is stopped
  native void function run() [calllink cmethod=unstop];
  ///stops motocar, if it is not stopped
  native void function stop() [calllink cmethod=stop];
}  


class Bridge extends GameStatic {
  native string property type get [calllink] set [calllink];
}

class Tunnel extends GameStatic {
  native string property type get [calllink] set [calllink];
}

class Building extends GameStatic {
  native property type get;
}

