class jtSemaphore extends jtObject {
}

class jtTree extends jtObject {
}

class jtTerrain extends jtObject {
}

class jtRail extends jtObject {
}

class jtRoad extends jtObject {
}

class Game {
  ///creates new empty game
  native constructor (int w,int h) [cmethod=newgame wantir];
  ///creates new game loaded from file
  native constructor (Archive ar) [cmethod=loadgame wantir cargs];
  ///X-position of mouse cursor, map coordinates
  native int property mapX get;
  ///Y-position of mouse cursor, map coordinates
  native int property mapY get;
  ///X-position of mouse cursor, map vertex coordinates
  native int property vertexX get;
  ///Y-position of mouse cursor, map vertex coordinates
  native int property vertexY get;
  ///X-position of mouse cursor, pixel coordinates
  native float property mouseX get;
  ///Y-position of mouse cursor, pixel coordinates
  native float property mouseY get;
  ///whether mouse cursor is in middle part of square
  native bool property mouseInMiddle get;
  ///draws custom square cursor
  native void function drawCustomCursor(int x,int y,string type,int dir);
  ///draws custom square cursor2
  native void function drawCustomCursors(int x1,int y1,int x2,int y2,string type,int dir);
  ///draws simple square cursor
  native void function drawCursor(int x,int y,string color);
  ///draws square cursor
  native void function drawComplexCursor(int x,int y,string color);
  ///draws point cursor (x,y are vertex coordinates)
  native void function drawPointCursor(int x,int y,string color);
  ///draws point cursors (x,y are vertex coordinates)
  native void function drawPointCursors(int x1,int y1,int x2,int y2,string color);
  ///draws square and line cursor
  native void function drawSqLineCursor(int x,int y,bool vertical,string framecolor,string linecolor);
  ///event handler(has methods onPaint(),onMouseMove(),...)
  native property handler get set;
  ///ends game
  native void function end();
  ///saves to archive
  native void function save(Archive ar) [cargs];
  ///blocks any feature (what=scroll|keys|click|run)
  native void function block(string what);
  ///unblocks any feature
  native void function unblock(string what);
  ///builds depot
  native void function buildDepo(int x1,int y1,int x2,int y2,int dir);
  ///builds railway station
  native void function buildRStation(int x1,int y1,int x2,int y2,int dir);
  ///builds bus stop
  native void function buildBusStop(int x,int y);
  ///return static object or null
  native GameObject function staticAt(int mapx,int mapy);
  ///returns mobile or null
  native GameObject function mobileAt(float mousex,float mousey);
  ///returns array of all static objects
  native Array property statics get;
  ///returns array of all mobiles
  native Array property mobiles get;
  ///retezcovy popis objektu (napr. RStation)
  ///string description of object (eg. RSattion)
  native string function objectType(int id);
  ///converts id to object
  native GameObject function objectFromId(int id);
  ///converts name to object
  native GameObject function objectFromName(string name);
  ///runs cicles-algorithm on empty map
  native void function generateCircles(int steps,float mindisp,float maxdisp,float minrad,float maxrad);
  ///sets height to value
  native void function clearHeights(float value);
  ///builds semaphore or changes semaphore type
  native void function buildSemaphore(int x,int y,string type);
  ///available machines
  native Array property machines get;
  ///available motocars
  native Array property motocars get;
  ///XML of currectly saved object (only in handling save event)
  native XMLNode property saving get [cresult calllink];
  ///destroys all loading information
  native void function loaded() [calllink];
  ///returns height of vertex
  native float function getHi(int x,int y);
  ///sets height of rectangle
  native void function setHi(int x,int y,int w,int h,float value);
  ///repairs heights aropund rectangle so that maximal leap is less than mhd
  native void function repairHeights(int x,int y,int w,int h,float mhd);
  ///erases surface railroad
  native void function eraseRail(int mapx,int mapy);
  ///fills water vertex vx,vy and fills around
  native void function fillWater(int vx,int vy,float waterhi);
  ///drys the lake
  native void function dryWater(int vx,int vy);
  ///must be x1==x2 or y1==y2, what="road"|"rail'
  native void function buildBridgeExact(int x,int y,int len,bool ver,float height,float dhisum,string what);
  ///must be x1==x2 or y1==y2, height is counted
  native void function buildBridge(int x,int y,int len,bool ver,float dhielem,string dhimode,string what);
  ///must be x1==x2 or y1==y2
  native void function buildTunnelExact(int x,int y,int len,bool ver,float height,float dhisum,string what);
  ///must be x1==x2 or y1==y2, height is counted
  native void function buildTunnel(int x,int y,int len,bool ver,float dhielem,string dhimode,string what);
  ///returns array of jtBridge 
  native property bridgeTypes get;
  ///returns array of jtTunnel
  native property tunnelTypes get;
  ///returns array of jtSemaphoree
  native property semaphoreTypes get;
  ///returns array of jtStation
  native property stationTypes get;
  ///returns array of jtDepo
  native property depoTypes get;
  ///returns array of jtAircraft
  native property aircraftTypes get;
  ///turn off watch
  native void function unWatch() [calllink cmethod=unwatch];
  ///deletes all mobiles
  native void function clearMobiles() [calllink cmethod=clearmobiles];
  ///dries all water
  native void function dryAll();
  ///plant tree at x,y
  native void function plant(int x,int y,string tree);
  ///returns array of jtTree
  native property treeTypes get;
  ///returns array of jtBuilding
  native property buildingTypes get;
  ///builds building
  native void function buildBuilding(int x,int y,int dir,jtBuilding type);
  ///builds building
  native void function buildBuildingExact(int x,int y,int dir,float hi,jtBuilding type);
  ///returns arrayf of jtTerrain
  native property terrainTypes get;
  ///sets terrain type for square x,y
  native void function setTerrain(int x,int y,string terrain);
  ///returns terrain array of jtRail
  native property railTypes get;
  ///returns terrain array of jtRoad
  native property roadTypes get;
  ///returns array of jtBusStop
  native property busStopTypes get;
  ///sets rail type for railrod at square x,y, for bridge or tunnel call set for edge square
  native void function setRail(int x,int y,string rail);
  ///builds runway
  native void function buildRunway(int x,int y,bool ver,int len);
  ///returns store (x,y) - viewport coordinates (-1..1)
  native function ltop(float x,float y,float h);
  ///draws ellipse (viewport coordinates)
  native void function drawCircle(float x,float y,float xrad,float yrad,string color);
  ///draws ellipse (map coordinates)
  native void function drawMapCircle(float x,float y,float xrad,float yrad,string color);
  ///returns mouse X screen cordinate
  native float property screenMouseX get;
  ///returns mouse Y screen cordinate
  native float property screenMouseY get;
  ///returns mouse X viewport cordinate
  native float property viewportMouseX get;
  ///returns mouse Y viewport cordinate
  native float property viewportMouseY get;
  ///rises heights in circle
  native void function riseCircle(float x,float y,float rad,float dhi);
  ///contains time in seconds of game frame
  native float property deltaTime get;
  ///map|cart
  native string property viewType get set;
  //centers view at map coords x,y
  native void function lookAt(int x,int y);
  ///gets template from map, saves to xml
  native void function storeRRTemplate(int x,int y,int w,int h,XMLNode xml) [cargs];
  ///uses template
  native void function useRRTemplate(int x,int y,int dir8,XMLNode xml) [cargs];
  ///draws template
  native void function drawRRTemplate(int x,int y,int dir8,XMLNode xml) [cargs];
  ///builds road at square [x,y]
  native void function buildRoad(int mapx,int mapy,float dhi,string mode);
  ///erases surface railroad
  native void function eraseRoad(int mapx,int mapy);
  
  //default machine
  native property machine0 get;
  //default motocar
  native property motocar0 get;
  
  ///sets rail type for railrod at square x,y, for bridge or tunnel call set for edge square
  native void function setRoad(int x,int y,string rail);

  //searchs machine, uses aliases, adds warning if no machine searched, returns machine0
  native function searchMachine(string name);
  
  native string property loadMessages get [calllink cmethod=getloadmessages];
  native void function addLoadMesasage(string msg) [calllink cmethod=addloadmessage];
}

class Textures {
  static native void function define(string name,string file) [cmethod=definetexture];
  static native void function clear() [cmethod=cleartextures];
}

class RRBuilder {
  native constructor(int mapx,int mapy) [wantrt cmethod=newrrbuilder];
  native void function build(int mapx,int mapy);
  native int property X get;
  native int property Y get;
//  native float property dHeight get set;
  native float property dHeight get [calllink cmethod=getdhi] set [calllink cmethod=setdhi];
  ///fixed|direct|change
  native string property mode get [calllink] set [calllink];
//  native bool property denyChange get [calllink cmethod=getdenychange] set [calllink cmethod=setdenychange];
  ///prirazenim null se rika, ze dhi se zvoli automaticky
//  native property dHeight get set;//get [calllink cmethod=getdhi] set [calllink cmethod=setdhi];
  native bool property autoFirstAndLast get [calllink cmethod=getautofirstandlast] set [calllink cmethod=setautofirstandlast];
}

class GameObject extends Store {
  //jednoznacne jmeno objektu
  native string property name get set;
  ///xml, odkud bylo nacitano, ruzi se zavolanim game.created()
  native XMLNode property loadXML get [calllink cmethod=getloadxml cresult];
  native void function remove() [calllink];
  native bool property valid get [cmethod=valid];
}

class ProxyGameObject extends GameObject {
  native constructor () [cmethod=newproxygameobject wantrt];
}

class Mobile extends GameObject {
//  native Track property track get;
  native string property name get [calllink];
  native void function watch() [calllink];
  native void function drive() [calllink];
  native void function wait(float secs) [calllink];
}

class Train extends Mobile {
//  void function toDepo();
  native constructor () [cmethod=newtrain wantrt];
  native void function loadCompose(XMLNode xml) [calllink cargs cmethod=loadcompose];
  native void function saveCompose(XMLNode xml) [calllink cargs cmethod=savecompose];
//  native string property compose get [calllink] set [calllink];
  //cil, kam jede, nastaveni muze vyhodit vyjimku, pokud tam nevede cesta
//  native RStation property headingTo get set;
  //nazvy vagonu oddelenych stredniky
  //zda je vlak zastaven
//  native bool property stopped get [calllink] set [calllink];
  //posle vlak do teto stanice, vrati, zda existuje cesta, kdyz ne, vlak stoji
  
  ///sends train to square x,y
  native bool function goToXY(int x,int y) [calllink cmethod=gotoxy];
  ///sends train to this station, if exists way, else train is stopped
  native bool function goTo(RStation station);
  ///reverses train, returns, whether way exists
  native bool function reverse() [calllink];
  ///releases train, if it is stopped
  native void function run() [calllink cmethod=unstop];
  ///stops train, if it is not stopped
  native void function stop() [calllink cmethod=stop];
  //vyrobi vlak v tomto depu
//  native void function start(RDepo depo);
  ///sends train to nearset depot, returns, wheteher any depo exists
  native bool function toDepo() [calllink cmethod=todepo];
  ///ignorus nearest semaphore
  native void function ignore() [calllink cmethod=ignoresems];
  ///state:stopped|noway|waitdepo|rest|station|godepo
  native string property state get [calllink cmethod=getstatestr];
//  native string property destination get [calllink cmethod=getdeststr];
  ///actual speed
  native float property speed get [calllink];
  native int property priority get [calllink] set [calllink];
  native bool function start(RDepo depo);
}

