module JTWinManager;

var left=10,top=30,right=Application.desktopW-10,maxy=Application.desktopH;

var onleft=true;
var cury=top;

var windows=[];
var closingall;

function closed(win) {
  if (closingall) return;
  windows.removeRef(win);
  if (windows.count==0) {
    onleft=true;
    cury=top;
  }
}

function closeAll() {
  closingall=true;
  for (w in windows) w.close();
  windows=[];
  closingall=false;
}

function toggle() {
  onleft=!onleft;
  cury=top;
}

function add(win) {
  windows.push(win);
}

function place(win) {
  if (cury+win.H>maxy) toggle();
  win.Y=cury;
  cury+=win.H;
  if (onleft) win.X=left;else win.X=right-win.W;
  add(win);
}
