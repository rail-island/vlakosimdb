module RLineModule;

requires module linesModule;

var priorityValues=[5,3,2,1];

class ComposeItem {
  readonly vagon;
  readwrite reverse;
  property name get {return vagon.name;}
  property text get {
    var res=vagon.title;
    if (reverse) res+="*";
    return res;
  }
  function save(xml) {
    xml->name=vagon.name;
    if (reverse) xml->reverse="1";else xml->reverse="0";
  }
  function load(xml) {
    var name=xml->name;
    vagon=JTycon.game.searchMachine(name);
/*
    if (!vagon) {
      vagon=JTycon.game.machine0;
      JTycon.loadWarning=JTycon.loadWarning&"warning:machine '"&name&"' not found\n";
    }
*/
/*    
    if (!vagon) {
      Window.alert("Vagon not found:"+name);
      Application.exit();
    }
*/
    reverse=xml->reverse=="1";
  }
  constructor (vagon) {this.vagon=vagon;}
  constructor () {}
}

class JTRLine extends JTLine {
  var compose=[];
  var trains=[];
  var directory;
  var picture;
  
  formname="jtycon.rlinefrm";
  stationtype=RStation;
  
  property compose get {
    var res=new XMLNode();
    res.name="compose";
    for (c in compose) c.save(res.add("item"));
    return res;
  }
  
  constructor () {
    proxy.name="L 1";
    proxy->priority=0;
    proxy->waittime=2;
  }
  
  function showtrain() {
    if (var t=trains[form->trains.cur]) JTycon.showobj(t);
  }
  
  function fillgroups() {
    form->groups.items="[..]\n[.]\n"&directory.childs.join({value.childs.count>0?"["&value.name&"]":value.name},"\n");
    form->groups.cur=1;
  }
  
  function getdir() {
    if (var res=directory.childs[form->groups.cur-2]) return res;
    return directory;
  }
  
  function fillmachines() {
    form->machines.items=getdir().elems.join({value.title},"\n");
  }
  
  function groupclick() {
    var lastdir=directory;
    var cur=form->groups.cur;
    if (cur==0 && directory.parent) directory=directory.parent;
    if (cur>=2) directory=directory.childs[cur-2];
    if (directory.childs.count==0 && directory.parent) directory=directory.parent;
    if (!lastdir===directory) fillgroups();
    fillmachines();
  }
  
  function paintimg(cnv) {
    cnv.bg("black").fg("white").rectangle(0,0,form->image.W-1,form->image.H-1);
    if (picture) picture.draw((form->image.W-picture.W)/2,form->image.H-picture.H-1,cnv);
  }
  
  function machinechange() {
    if (var machine=getdir().elems[form->machines.cur]) {
      form->author.text=machine.author;
      form->power.text=machine.power;
      form->maxspeed.text=machine.maxSpeed;
      picture=null;
      if (machine.data.hasFile("image.bmp")) {
        var pth=machine.data.getFile("image.bmp");      
        picture=new Picture();
        picture.load(pth);
        machine.data.closedGetFile(pth,"image.bmp");
      }
    }
  }
  
  function initform() {
//    form->machines.items=JTycon.game.machines.join({value.title},"\n");
    if (!directory) directory=JTycon.machdir;
    if (proxy->waittime<1) proxy->waittime=1;
    form->waitbar.cur=proxy->waittime;
    waitchange();
    fillgroups();
    fillmachines();
    form->priority.cur=priorityValues.search(proxy->priority);
    trains=game.mobiles.collect({value is Train && value->line===this});
    form->trains.items=trains.join({value.name&":"&value.state},"\n");
    picture=null;
    
    updatecomp();
  }
  function addvagon() {
    if (var m=getdir().elems[form->machines.cur]) {
      compose.push(new ComposeItem(m));
      updatecomp();
    }
  }
  function delvagon() {
    if (var cur=compose[form->compose.cur]) {
      compose.removeRef(cur);
      updatecomp();
    }
  }
  function waitchange() {
    form->waitlabel.text=form->waitbar.cur&" sec";
    proxy->waittime=form->waitbar.cur;
  }
  function upvagon() {
    if (compose.moveUp(form->compose.cur)) form->compose.cur--;
    updatecomp();
  }
  function downvagon() {
    if (compose.moveDown(form->compose.cur)) form->compose.cur++;
    updatecomp();
  }
  function reversevagon() {
    if (var cur=compose[form->compose.cur]) {
      cur.reverse=!cur.reverse;
      updatecomp();
    }
  }
  function prichange() {
    proxy->priority=priorityValues[form->priority.cur];
    linesModule.updatelines();
  }
  function updatecomp() {
    form->compose.items=compose.join({value.text},"\n");
  }
  function savespec(xml) {
    var comp=xml.add("compose");
    for (c in compose) c.save(comp.add("item"));
    xml.name="line";
    xml->priority=proxy->priority;
    xml->waittime=proxy->waittime;
  }
  function loadspec(xml) {
    compose=[];
    for (c in xml-/compose) {
      var it=new ComposeItem();
      it.load(c);
      compose.push(it);
    }
    proxy->priority=xml->priority;
    proxy->waittime=xml->waittime;
  }
}
linesModule.lineTypes->line=JTRLine;

