module terCreatModule;

var form,win;
var game;

var maxabsdhi=10;

var rad=5;
var maxrad=20;
var minrad=2;

var mindhi=0.1;
var maxdhi=1;
var actdhi=0.5;

var dirk=1;//nahoru nebo dolu

//var scrpt0;
var changing;

var werelines;

function show() {
  if (form) return;
  form=new Form();
  form.handler=this;
  win=form.loadWindow("jtycon.tercreatfrm");
  win.show();
  game=JTycon.game;
  JTycon.state=this;
  JTWinManager.place(win);
  werelines=Application.options-/opengl->heightlines;
  Application.options-/opengl->heightlines="1";
}

function mountains() {
  JTycon.state=this;
}

function onclose() {
  if (JTycon.state===this) JTycon.state=null;
  Application.options-/opengl->heightlines=werelines;
  JTWinManager.closed(win);
  form.destroy();
  form=null;
  win=null;
}

function onpaint() {
  var x=game.vertexX,y=game.vertexY;
  
//  var rsm=rad*(1-dhik.abs());
//  game.drawMapCircle(x,y,rsm,rsm,dhik<0?"blue":"yellow");
  
  game.drawMapCircle(x,y,rad,rad,"red");
  if (changing) {
    var dhi=actdhi*rad;
    if (dhi>maxabsdhi) dhi=maxabsdhi;
    game.riseCircle(x,y,rad,dirk*game.deltaTime*dhi);
  }
}

function changed() {
  rad=(form->size.cur/100)*(maxrad-minrad)+minrad;
  actdhi=(form->height.cur/100)*(maxdhi-mindhi)+mindhi;
}

function mdown(button) {
  select (button) {
    "left":{
      changing=true;
      dirk=1;
    }
    "right":{
      changing=true;
      dirk=-1;
//      scrpt0=new (x=game.screenMouseX,y=game.screenMouseY);
    }
  }
}

function mup(button) {
  changing=false;
//  scrpt0=null;
}

function mmove() {
/*  if (scrpt0) {
    var pt=new (x=game.screenMouseX,y=game.screenMouseY);
    var dx=pt->x-scrpt0->x,dy=pt->y-scrpt0->y;
    rad+=(maxrad-minrad)*dx*game.deltaTime;
    if (rad<minrad) rad=minrad;
    if (rad>maxrad) rad=maxrad;
    dhik+=dy*game.deltaTime;
    if (dhik<-0.9) dhik=-0.9;
    if (dhik>0.9) dhik=0.9;
    scrpt0=pt;
  }*/
}


