module airportBuildModule;

var form,win;
var runwaypt0;//prvni bod u ranveje
var game;
var runwaydir;
var runwaywi=1;

function show() {
  if (form) return;
  game=JTycon.game;
  form=new Form();
  form.handler=this;
  win=form.loadWindow("jtycon.airportfrm");
  runwaydir="hor";
  win.show();
  JTycon.state=this;
  JTWinManager.place(win);
}

function onclose() {
  JTWinManager.closed(win);
  form.destroy();
  form=null;
  win=null;
  bld=null;
  if (JTycon.state===this) JTycon.state=null;
}

function makerect(x,y) {
  var res=new Store();
  if (!runwaypt0) return null;
  select (runwaydir) {
    "hor":{
      res->x1=Math.min(x,runwaypt0->x);
      res->y1=y;
      res->x2=Math.max(x,runwaypt0->x);
      res->y2=y+runwaywi-1;
      res->ver=false;
      res->len=res->x2-res->x1+1;
    }
    "ver":{
      res->x1=x;
      res->y1=Math.min(y,runwaypt0->y);
      res->x2=x+runwaywi-1;
      res->y2=Math.max(y,runwaypt0->y);
      res->ver=true;
      res->len=res->y2-res->y1+1;
    }
  }
  return res;
}

function mdown(button) {
  select (button) {
    "left":{
      if (runwaydir) {
        if (runwaypt0) {
          var r=makerect(game.mapX,game.mapY);
          game.buildRunway(r->x1,r->y1,r->ver,r->len);
          runwaypt0=null;
        } else {
          runwaypt0=new (x=game.mapX,y=game.mapY);
        }
      }
    }
    "right":{
      if (runwaydir) {
        if (runwaydir=="hor") runwaydir="ver";else runwaydir="hor";
      }
    }
  }
}

function mup(button) {
}

function mmove() {
}

function onpaint() {
  if (runwaypt0) {
    var r=makerect(game.mapX,game.mapY);
    for (var x=r->x1;x<=r->x2;x++) for (var y=r->y1;y<=r->y2;y++) game.drawSqLineCursor(x,y,r->ver,"red","green");
  } else {
    if (runwaydir) game.drawSqLineCursor(game.mapX,game.mapY,runwaydir=="ver","red","green");
  }
}

function bldairport() {
  JTycon.state=this;
  runwaydir="hor";
  runwaypt0=null;
}
