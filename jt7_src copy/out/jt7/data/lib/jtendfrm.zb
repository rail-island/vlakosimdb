module endModule;

var form,win;

function show(name) {
  if (form) close();
  form=new Form();
  form.handler=this;
  win=form.loadWindow("jtycon."+name+"frm");
  win.show();
  JTWinManager.add(win);
}

function close() {
  JTWinManager.closed(win);
  form.destroy();
  form=null;
  win=null;
}

function quit() {
  JTycon.doquit();
}

function exit() {
  JTycon.doexitgame();
}
