module treesModule;

include module commonTypeModule;

var formname="jtycon.treefrm";

class NOTREE {
  readonly title="[---]";
  readonly name="";
  constructor () {}
}

function gettypes() {
  var res=[new NOTREE()];
  for (t in game.treeTypes) res.push(t);
  return res;
}

function work(x,y,name) {
  game.plant(x,y,name);
}

