module JTWins;

class JTWindow {
  var obj;
  var win;
  var form;
  var lines;
  var types;
  var waypoints=[];
  
  var renamewin;
  var renameform;
  function dorename() {
    if (renameform) return;
    renameform=new Form();
    renamewin=renameform.loadWindow("jtycon.renamewin");
    renameform.handler=this;
    renameform->nameedit.text=obj.name;
    renamewin.show();
  }
  function renameok() {
    obj.name=renameform->nameedit.text;
    renameclose();
  }
  function renameclose() {
    renameform.destroy();
    renameform=null;renamewin=null;
  }
  function onclose() {
    trainModule.closed();
    JTWinManager.closed(win);
    win=null;
    form.destroy();
    form=null;
  }
  function doclose() {
    win.close();
  }
  function watch() {
    obj.watch();
  }
  function remove() {
    obj.remove();
  }
  function changedObject() {
    if (form && win) inspect (obj) {
      RDepo:{
        win.text="$Depo";
//        form->trains.items=obj.trains.join({value.name},"\n");
      }
      RStation:win.text="$Railway-station "+obj.name;
      Airport:win.text="$Airport "+obj.name;
      BusStop:win.text="$Bus-stop "+obj.name;
      Train:{
        form->state.text=obj.state;
        form->speed.text=obj.speed.round();
        form->dest.text=obj->line[obj->destindex].name;
        form->linename.text=obj->line.name;
      }
      Motocar:{
        form->state.text=obj.state;
        form->speed.text=obj.speed.round();
        form->dest.text=obj->line[obj->destindex].name;
        form->linename.text=obj->line.name;
      }
      Aircraft:{
//        form->state.text=obj.state;
//        form->speed.text=obj.speed.round();
        form->state.text="";
        form->speed.text="";
        form->dest.text=obj->line[obj->destindex].name;
        form->linename.text=obj->line.name;
      }
    }
  }
  function drive() {
    obj.drive();
  }
  function savemobileline(xml) {
    xml->line=obj->line.name;
    xml->destindex=obj->destindex;
    xml->wpindex=obj->wpindex;
  }
  function savetrain(xml) {
    savemobileline(xml);
  }
  function saveaircraft(xml) {
    savemobileline(xml);
  }
  function savemotocar(xml) {
    savemobileline(xml);
  }
  function loadmobileline(xml) {
    obj->line=linesModule.lines.searchIf({xml->line==value.name});
    obj->destindex=new Number(xml->destindex);
    obj->wpindex=new Number(xml->wpindex);
  }
  function loadtrain(xml) {
    loadmobileline(xml);
  }
  function loadaircraft(xml) {
    loadmobileline(xml);
  }
  function loadmotocar(xml) {
    loadmobileline(xml);
  }
  function objectEvent(type) {
    inspect (obj) {
      Train:select (type) {
        "destreached":destreached();
        "nodest":setnewdest();
        "save":savetrain(JTycon.game.saving);
      }
      Aircraft:select (type) {
        "save":saveaircraft(JTycon.game.saving);
        "destreached":destreached();//nextstation();
      }
      Motocar:select (type) {
        "save":savemotocar(JTycon.game.saving);
        "destreached":destreached();//nextstation();
      }
    }
  }
  function rebuild() {
    obj.type=types[form->types.cur];
  }
  constructor (obj) {this.obj=obj;}
  function createwin(name) {
    form=new Form();
    win=form.loadWindow("jtycon."+name);
    form.handler=this;
    inspect (obj) {
      RDepo:{
        lines=linesModule.lines.collect({value is JTRLine});
        form->lines.items=lines.join({value.name},"\n");
        
        types=game.depoTypes;
        form->types.items=types.join({value.title},"\n");
        form->types.cur=types.searchString(obj.type);
      }
      Bridge:{
        types=game.bridgeTypes;
        form->types.items=types.join({value.title},"\n");
        form->types.cur=types.searchString(obj.type);
      }
      Tunnel:{
        types=game.tunnelTypes;
        form->types.items=types.join({value.title},"\n");
        form->types.cur=types.searchString(obj.type);
      }
      RStation:{
        types=game.stationTypes;
        form->types.items=types.join({value.title},"\n");
        form->types.cur=types.searchString(obj.type);
      }
      Airport:{
        lines=linesModule.lines.collect({value is JTALine});
        form->lines.items=lines.join({value.name},"\n");
      }
      BusStop:{
        types=game.busStopTypes;
        lines=linesModule.lines.collect({value is JTMLine});
        form->lines.items=lines.join({value.name},"\n");
        form->types.items=types.join({value.title},"\n");
        form->types.cur=types.searchString(obj.type);
      }
    }
    win.show();
    JTWinManager.place(win);
    changedObject();
  }
  function showwindow() {
    if (!win) createwin();
  }
  function createwin() {
    inspect (obj) {
      RDepo:createwin("rdepofrm");
      RStation:createwin("rstfrm");
      Train:createwin("trainfrm");
      Motocar:createwin("motocarfrm");
      Aircraft:createwin("aircraftfrm");
      Bridge:createwin("bridgefrm");
      Airport:createwin("airportwin");
      BusStop:createwin("busstopwin");
      Tunnel:createwin("tunnelfrm");
    }
  }  

//*********************LINES****************************
/*
  function nextstation() {
    nextmobiledest();
    setmobiledest();
    obj.wait(2);
  }
*/
/*  
  function nextdest() {
    obj->destindex++;
    if (obj->destindex>=obj->line.count) obj->destindex=0;
    setmobiledest();
//    setnewdest();
  }
  function nextwaypoint() {
    if (var wp=waypoints[obj->wpindex]) {
      obj.goToXY(wp.x,wp.y);
      obj->wpindex++;
    } else setnewdest();
  }
*/
  function destreached() {
    var wait=obj->wpindex>=waypoints.count;
    nextmobiledest(obj);
    setmobiledest(obj);
    if (wait) obj.wait(obj->line.proxy->waittime);
  }
/*
    if (obj.state=="xy") {
      
    } else if (obj.state=="go") nextstation();
    else {
      setnewdest();
    }
  }
*/
  function setnewdest() {
    var dest=obj->line[obj->destindex];
    if (dest.valid) obj.goTo(dest);
  }
  function nextmobiledest(train) {
    train->wpindex++;
    if (obj->wpindex>waypoints.count) {
      train->wpindex=0;
      train->destindex++;
      if (train->destindex>=train->line.count) train->destindex=0;
      waypoints=train->line.stations[train->destindex].waypoints;
    }
  }

  function elsewhere() {
    obj->wpindex=waypoints.count;
    nextmobiledest(obj);
    setmobiledest(obj);
  }

  function setmobiledest(train) {
    if (var wp=waypoints[train->wpindex]) {
      obj.goToXY(wp.x,wp.y);
    } else {
      var dest=train->line[train->destindex];
      if (dest.valid) train.goTo(dest);
    }
  }

//*********************TRAIN****************************

  function newtrain() {
    if (form->lines.cur<0) return;
    var train=new Train();
    train->line=lines[form->lines.cur];
    train.loadCompose(train->line.compose);
    train.start(obj);
    train.priority=train->line.proxy->priority;
    waypoints=train->line.stations[0].waypoints;
    train->destindex=0;
    train->wpindex=0;
    setmobiledest(train);
    train.run();
  }
  function newaircraft() {
    if (form->lines.cur<0) return;
    var air=new Aircraft(obj);
    air->line=lines[form->lines.cur];
    var idx=1;if (idx>=air->line.count) idx=0;
    air.type=air->line.proxy->vehicle;
    air.goTo(air->line[idx]);
    air->destindex=idx;
    air->wpindex=0;
  }
  function newmotocar() {
    if (form->lines.cur<0) return;
    var car=new Motocar();
    car->line=lines[form->lines.cur];
    var idx=1;if (idx>=car->line.count) idx=0;
    car.goTo(car->line[idx]);
    car.type=car->line.proxy->vehicle;
    car.start(obj);
    car->destindex=idx;
    car->wpindex=0;
  }
  function runtrain() {
    if (var train=obj.trains[form->trains.cur]) {
      train->destindex=0;
      train.goTo(train->line[0]);
      train.run();
    }
  }

  function startstop() {
    if (obj.state=="stopped") obj.run();else obj.stop();
  }
  function trainreverse() {
    if (obj.reverse()) obj.run();
  }
  function traintodepo() {
    if (obj.toDepo()) obj.run();
  }
  function ignore() {
    obj.ignore();
  }

  function gotoxy() {
    trainModule.gotoXY(obj);
  }
  
}

