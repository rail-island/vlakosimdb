module trainModule;

var train;

function onpaint() {
  game.drawCustomCursor(game.mapX,game.mapY,Cursors.trainGoToXY,0);
}

function mdown(button) {
  train.goToXY(game.mapX,game.mapY);
  JTycon.state=null;
}

function mup(button) {}

function mmove() {}

function gotoXY(train) {
  this.train=train;
  JTycon.state=this;
}

function closed() {
  if (JTycon.state===this) JTycon.state=null;
}

