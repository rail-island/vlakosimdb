<?xml version="1.0" encoding="Windows-1250"?>
<data>

<window rep.name="form.smokeeditor" layout="vlist" state="max" closeonesc="1" text="Smoke Editor" menu="menu.smokeeditor">
  <panel ll.vsize="25" layout="hflow">
    <trackbar min="0" max="200" cur="40" name="speed" hint="$Speed"/>
    <panel h="20" w="50" layout="1"><label name="fps"/></panel>
  </panel>
  <panel layout="hlist">
    <panel ll.hsize="20%">
    </panel>
    <place name="glv" layout="1"/>
  </panel>
</window>

<menubar rep.name="menu.smokeeditor">
  <popup text="$Smoke">
    <do text="$Quit" onclick="quit()"/>
  </popup>
</menubar>

</data>
