module rotateColorizeModule;

include module editBitmapsModuleBase;

var actcolorize;
var form,win;
var colorizes;
var zipobj;

function run(xml,zipobj) {
  this.zipobj=zipobj;
  colorizes=xml;
  form=new Form();
  form.handler=this;
  win=form.loadWindow("poed.rotatesolidwin");
  initcolorizepage();
  win.showModal();
  donecolorizepage();
  form.destroy();
  form=null;win=null;
}

function saveactcolorize() {
  if (actcolorize) {
    win.saveData(actcolorize);
  }   
}

function loadactcolorize() {
  if (actcolorize) {
    win.loadData(actcolorize);
  }   
}

function initcolorizepage() {
  actcolorize=null;
  bitmappicture=null;
  visibletexture=null;
  form->matfiles.items=(File.root/"data"/"materials").listFiles("*.bmp").join("\n");
  updatecolorizelist();
  updatebitmapfiles();
}

function onclose() {
  saveactcolorize();
}

function donecolorizepage() {
  saveactcolorize();
  actcolorize=null;
  bitmappicture=null;
  zipobj=null;
}

function updatecolorizelist() {
  form->colorizelist.items=colorizes.childs.join({value->texture&"["&value->comment&"]"},"\n");
  form->colorizelist.cur=-1;
}

function addcolorize() {
  saveactcolorize();
  var s=colorizes.add("colorize");
  updatecolorizelist();
  actcolorize=null;
  form->colorizelist.cur=colorizes.count-1;
  actcolorize=s;
  loadactcolorize();  
}

function erasecolorize() {
  if (actcolorize) {
    actcolorize.remove();
    actcolorize=null;
    updatecolorizelist();
  }
}

function changecolorizelist() {
  saveactcolorize();
  actcolorize=colorizes[form->colorizelist.cur];
  loadactcolorize();
}


