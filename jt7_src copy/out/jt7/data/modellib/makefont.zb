module makeFontModule;

var impchars="abcdefghijklmnopqrstuvwqxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_ +-=*/(){}[]<>;,.?#@%^&!";

function makefont(fnt,w,h) {
  var xml=new XMLNode();
  xml.name="opengl_font";
  var pic=new Picture();
  pic.W=w;pic.H=h;
  var x=0,y=0;
  var cnv=pic.canvas;
  cnv.fg("none").bg("white").rectangle(0,0,w+1,h+1);
  cnv.font(fnt);
  xml->w=w;xml->h=h;
  var chars=impchars&Application.options->font_local_chars;
  for(var i=0;i<chars.length;i++) {
    var xchar=xml.add("char");
    var ch=chars[i];
    var acth=cnv.texthi(ch),actw=cnv.textwi(ch);
    if (x+actw>w) {
      y+=acth;x=0;
    }
    if (y+acth>h) return false;
    cnv.text(x,y,ch);
    xchar->ch=ch;
    xchar->x=x;
    xchar->y=y;
    xchar->w=actw;
    xchar->h=acth;
    x+=actw;
  }
  pic.invert();
  pic.save(File.root/"data"/"font_images.bmp");
  xml.save(File.root/"data"/"font_sizes.xml");
  return true;
}

function run() {
  var f=new Font();
  if (f.edit()) {
    if (makefont(f,64,64)) return;
    if (makefont(f,128,64)) return;
    if (makefont(f,128,128)) return;
    if (makefont(f,256,128)) return;
    if (makefont(f,256,256)) return;
    Window.alert("$cannot-create-font-msg");
  }  
}