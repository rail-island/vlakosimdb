module simpleEditModule;

include module editBitmapsModuleBase;
include module simpleEditInlinesModule;
include module simpleEditColorizeModule;
include module simpleEditShapesModule;
include module editNoiseModule;
include module bitmapEditBaseModule;

var window;
var form;
var dx=0,dy=0,scale=1,scalex=1,scaley=1,scalecur=0;
var ismoving;
var lastmx=0,lastmy=0;
var csize2=4;
var selpt;
var selshapept;
var selline;
var ptdist=0;
var shapeptdist=0;
var movingpt;
var movingshapept;
var maxdeletedist=5;
var maxmovedist=5;
var jumpx=0.01;
var jumpy=0.01;
//var picture;
var picfile;//soubor, ze ktereho obrazek je
var pichflip,picvflip;//zda byl obraz pretocen
//var picmodified=false;
//var bakpicture;
var picx0,picy0;
var picw,pich;
var inlinept0;
var inlinesizing;
var modelview;
var lastpage=0;

var stamppt0;
var stampsizing;

var selstamp;//selected stamp

var smodel;//model (argument run)
var zipobj;//objekt, ktery se edituje
var curalong;//dite smodel (alongx/alongy/alongz)
var polygon;//polygon, ktery se prave edituje
var colorize;//ukazuje na colordec nebo colorinc
var colorizes=[];//co je v listboxu colorizes

var movauxpt0;//move aux
var selshapeline;//aktualni line

function loadPicture(pic,file) {
  var path=zipobj.getFile(file);
  pic.load(path);
  zipobj.closedGetFile(path,file);
}

function savePicture(pic,file) {
  var path=zipobj.setFile(file);
  pic.save(path);
  zipobj.closedSetFile(path,file);
}

function dorender() {
  savepic();
  Textures.clear();
  simpleObjectModule.recount(smodel,zipobj);
  modelview.load(smodel-/model,zipobj);
}

function editdeletefaces() {
  if (var res=Window.inputBox("POEdit","$Put-faces-to-delete-separated-by-semicolor",smodel->deletefaces))
    smodel->deletefaces=res;
}

function editcrook() {
  if (var res=winTools.editText(smodel.forceSub("crook").text)) smodel-/crook.text=res;
}

function render() {
  dorender();
  form->pager.cur=1;
}

function savelastpage() {
  select (lastpage) {
    2:saveactcolorize();
    3:saveinline();
    4:saveactshape();
    5:saveactnoise();
  }
}

function changepager() {
  savelastpage();
  lastpage=form->pager.cur;
  select (form->pager.cur) {
    1:dorender();
    2:loadactcolorize();
    3:loadinline();
    4:loadactshape();
    5:updatenoisepage();
  }
}

function close() {
  if (form->pager.cur>0) form->pager.cur=0;
  else window.close();
}

function run(xml,obj) {
  var opt=Application.options.forceSub("edpoly");
  this.smodel=xml;
  this.zipobj=obj;
  
  form=new Form();
  form.handler=this;
  window=form.loadWindow("model.simpleedfrm");
  modelview=new ModelView(form->modelview);
  curalong=null;
  polygon=null;
  picture=null;
  picmodified=false;
  selstamp=null;
  stamppt0=null;
  lastpage=0;
  
  form->along.cur=xml->edit_along;
  
  alongchange();
  colorizechange();
  
  initinlinepage();
  initcolorizepage();
  initshapepage();
  initnoisepage();
//  initmaterialpage();
//  initstamppage();
  
  updateinlines();
  
  fillcolors(form->colortable);
//  form->crookmemo.text=smodel.forceSub("crook").text;  
//  var fnt=new Font();fnt.name="Courier New";fnt.size="12";
//  form->crookmemo.font=fnt;
  
  window.showModal();
  
  savelastpage();
  
  donenoisepage();
//  doneinlinepage();
//  donecolorizepage();
//  doneshapepage();
//  donematerialpage();
//  donestamppage();
  
  saveeditprops();
  savepic();  
  
  xml->edit_along=form->along.cur;

//  smodel.forceSub("crook").text=form->crookmemo.text;
  
  form.destroy();
  
  Textures.clear();
  
  modelview.destroy();
  modelview=null;
  xml=null;
  form=null;
  window=null;
}

/*
function auxltopx(l,transp) {
  option directly;
  if (transp) return (1-l)*form->pp.W/2*scalex+dx;
  return (l+1)*form->pp.W/2*scalex+dx;
}
function auxltopy(l,transp) {
  option directly;
  if (transp) (l+1)*form->pp.H/2*scaley+dy;
  return (1-l)*form->pp.H/2*scaley+dy;
}
*/

function ltopx(l) {directly return (l+1)*form->pp.W/2*scalex+dx;}
function ltopy(l) {directly return (1-l)*form->pp.H/2*scaley+dy;}
function ptolx(p) {directly return (p-dx)*2/form->pp.W/scalex-1;}
function ptoly(p) {directly return 1-(p-dy)*2/form->pp.H/scaley;}
function ptolbmpx(p) {if (!picture || picw==0) return 0;directly return (picture.W*(ptolx(p)-picx0)/picw-0.5).round();}
function ptolbmpy(p) {if (!picture || pich==0) return 0;directly return (picture.H*(1-(ptoly(p)-picy0)/pich)-0.5).round();}
//function ltopbmpx(l) {if (!picture) return 0;directly return ltopx( (l+0.5)*picw/picture.W+picx0 );}
//function ltopbmpy(l) {if (!picture) return 0;directly return ltopy( ((l+0.5)/picture.H-1)*(0-pich)+picy0 );}

function inl_gettx(xml) {return new Number(xml.getVar(["tz","tx","tx"][form->along.cur]));}
function inl_getty(xml) {return new Number(xml.getVar(["ty","tz","ty"][form->along.cur]));}
function inl_getsx(xml) {return new Number(xml.getVar(["sz","sx","sx"][form->along.cur]));}
function inl_getsy(xml) {return new Number(xml.getVar(["sy","sz","sy"][form->along.cur]));}

function inl_settx(xml,v) {xml.setVar(["tz","tx","tx"][form->along.cur],v);}
function inl_setty(xml,v) {xml.setVar(["ty","tz","ty"][form->along.cur],v);}
function inl_setsx(xml,v) {xml.setVar(["sz","sx","sx"][form->along.cur],v);}
function inl_setsy(xml,v) {xml.setVar(["sy","sz","sy"][form->along.cur],v);}

function shp_getx(xml) {return new Number(xml.getVar(["z","x","x"][form->along.cur]));}
function shp_gety(xml) {return new Number(xml.getVar(["y","z","y"][form->along.cur]));}
function shp_setx(xml,v) {xml.setVar(["z","x","x"][form->along.cur],v);}
function shp_sety(xml,v) {xml.setVar(["y","z","y"][form->along.cur],v);}

function updateinlines() {
  var items=smodel.forceSub("inlines").childs.join({value->name&"("&value->comment&")"},"\n");
  form->inlinelist.items=items;
  form->inlines.items=items;
}

function actinline() {
  if (form->inlines.cur>=0) return smodel-/inlines[form->inlines.cur];
  return null;
}

function inlinechange() {
  changeview();
}

function colorizechange() {
  savepic();
  selstamp=null;
  colorize=null;picture=null;bakpicture=null;
  if (!curalong) return;
  if (form->colorize.cur>=0) colorize=colorizes[form->colorize.cur];
//  var cur=["colorinc","colordec"][form->colorize.cur];
//  if (curalong.isSub(cur)) colorize=curalong.getSub(cur);
  actpic();
  changeview();
}

function togglenextpolygonorstamp() {
  nextpolygonorstamp(1);
  changeview();
}
function toggleprevpolygonorstamp() {
  nextpolygonorstamp(-1);
  changeview();
}

function nextpolygonorstamp(d) {
  if (form->mode.cur==4) {
    nextstamp(d);
  } else if (form->mode.cur>=7 && form->mode.cur<=10) {
    var cnt=form->shapes.items.split("\n").count;
    var newcur=form->shapes.cur+d;
    if (newcur>=cnt) newcur=0;
    if (newcur<0) newcur=cnt-1;
    form->shapes.cur=newcur;
  } else {
    nextpolygon(d);
  }
}

function nextpolygon(d) {
  var last=polygon;
  polygon=null;
  if (!curalong) return;
  var clip=curalong-/clip;
  if (clip.count==0) return;
  if (!last) {polygon=clip[0];return;}
  var idx=-1;
  for(var i=0;i<clip.count;i++) if (clip[i]==last) idx=i;
  idx+=d;
  if (idx>=clip.count) idx=0;
  if (idx<0) idx=clip.count-1;
  polygon=clip[idx];
}

function nextstamp(d) {
  var last=selstamp;
  selstamp=null;
  
  if (!colorizes) return;
  
  var idx=-1;
  for(var i=0;i<colorizes.count;i++) if (colorizes[i]===last) idx=i;
  idx+=d;
  
  if (idx>=colorizes.count) idx=0;
  if (idx<0) idx=colorizes.count-1;
  selstamp=colorizes[idx];
}

function addpoly() {
  if (!curalong) return;
  var apply="base";
  if (polygon) apply=polygon->apply;
  var clip=curalong-/clip;
  polygon=clip.add();polygon.name="polygon";
  polygon->apply=apply;
  clearpolygon();
}

function erasepoly() {
  if (polygon) {
    polygon.remove();
    polygon=null;
    nextpolygon(0);
    changeview();
  }
}

function clearpolygon() {
  if (!polygon) return;
  selpt=null;selline=null;
  polygon.clearSubs();
  addpt(0,0);addpt(0,1);addpt(1,1);addpt(1,0);
  changeview();
}


function alongchange() {
  savepic();
  saveeditprops();
  curalong=smodel.getSub( ["alongx","alongy","alongz"] [form->along.cur] );
  colorizes=smodel-/colorizes.childs.collect({hascurdir(value) && (value->stamp=="1" || value->material!="1") });
  form->colorize.items=colorizes.join({value->texture},"\n");
  polygon=null;
  nextpolygon(0);
  loadeditprops();
  colorizechange();
  changeview();
}

function roundx(x) {
  if (jumpx>0) directly return ((x/jumpx).round())*jumpx;
  return new Number(x);
}
function roundy(y) {
  if (jumpy>0) directly return ((y/jumpy).round())*jumpy;
  return new Number(y);
}

function savepic() {
  if (picmodified && picture) {
    undrawselect();
    if (picvflip) picture.vflip();
    if (pichflip) picture.hflip();
    savePicture(picture,picfile);
//    picture.save(picfile);
  }
}

function actpicpos() {
  var xml=colorize;
  if (!xml) return;
  var x1=new Number(xml->texx1);
  var x2=new Number(xml->texx2);
  var y1=new Number(xml->texy1);
  var y2=new Number(xml->texy2);
  if (x1>x2) {pichflip=true;picture.hflip();}
  if (y1>y2) {picvflip=true;picture.vflip();}
  picx0=x1;if (x2<picx0) picx0=x2;
  picy0=y1;if (y2<picy0) picy0=y2;
  picw=(x1-x2).abs();
  pich=(y1-y2).abs();
//  window.text=picw&";"&x1&";"&x2;
}

function actpic() {
  savepic();
  var xml=colorize;
  picture=null;bakpicture=null;picmodified=false;
  if (!xml) return;
  var file=Textures.textureFile(xml->texture);
//  var file=xml->texture;
//  if (file && file.isFile()) {
  if (file!="" && !xml->texture.beginsWith("material:")) {
    picfile=file;pichflip=false;picvflip=false;
    picture=new Picture();
    loadPicture(picture,file);
//    picture.load(file);
    actpicpos();
    bakpicture=picture.clone();
  }
}

function drawmodeset() {
  if (form->drawmode.cur>=0) form->mode.cur=-1;
  changeview();
}

function actshape() {
  return smodel-/shapes.childs[form->shapes.cur];
}

function shapeschange() {
}

function setmode() {
  selstamp=null;
  if (form->mode.cur>=0) {
    undrawselect();
    form->drawmode.cur=-1;
  }
  if (form->mode.cur==3) {
    if (!actinline()) {
      Window.alert("$Inline-object-is-not-active");
      form->mode.cur=-1;
    }
  }
  if (form->mode.cur==7 || form->mode.cur==8 || form->mode.cur==9) {
    if (!actshape() || actshape()->type!="rotate") {
      Window.alert("$Rotate-shape-not-selected");
      form->mode.cur=-1;
    }
  }
}

function loadeditprops() {
  if (!curalong) return;
  var xml=curalong;
  dx=new Number(xml->edit_dx);dy=new Number(xml->edit_dy);
  scalecur=xml->edit_scale;
  form->scale.cur=scalecur;
  jumpx=xml->edit_jumpx;jumpy=xml->edit_jumpy;
  if (jumpx<=0) jumpx=0.01;if (jumpy<=0) jumpy=0.01;
  form->jumpx.text=jumpx;form->jumpy.text=jumpy;
  form->colorize.cur=xml->edit_incdec;
//  form->pencolor.text=xml->edit_pencolor;
}

function saveeditprops() {
  if (!curalong) return;
  var xml=curalong;
  xml->edit_dx=dx;xml->edit_dy=dy;
  xml->edit_scale=scalecur;
  xml->edit_jumpx=jumpx;xml->edit_jumpy=jumpy;
  xml->edit_incdec=form->colorize.cur;
//  xml->edit_pencolor=form->pencolor.text;
}

function setimage() {
  if (!colorize) return;
  Application.runXMLDialog(Application.findResource("model.colorizefrm"),colorize);
  actpic();
  changeview();
}

function changescale() {
  scalecur=form->scale.cur;
  changeview();
}

function changeview() {
  scale=0.01*(1.1).power(scalecur);
  var w=form->pp.W,h=form->pp.H;
  if (w>h) {
    scaley=scale;
    scalex=scale*h/w;
  } else {
    scalex=scale;
    scaley=scale*w/h;
  }
  form->pp.repaint();
}

function changejump() {
  jumpx=new Number(form->jumpx.text);
  jumpy=new Number(form->jumpy.text);
  if (jumpx<=0) jumpx=0.01;if (jumpy<=0) jumpy=0.01;
}

function addpt(x,y) {
  var a=polygon.add();a.name="point";
  a->x=x;a->y=y;
  return a;
}

function hascurdir(stamp) {
  option directly;
  var dir=form->along.cur;
  var ar=stamp->dirs.split(";");
  return "1"==ar[2*dir] || "1"==ar[2*dir+1];
}

//vzdalenost bodu od usecky a,b - priblizne, jen pro ucely porovnani
function shapelinedist(a,b,x,y) {
  var ax=ltopx(shp_getx(a)),ay=ltopy(shp_gety(a)),bx=ltopx(shp_getx(b)),by=ltopy(shp_gety(b));
  return dist(ax,ay,x,y)+dist(bx,by,x,y)-dist(ax,ay,bx,by);
}

//vrati index bodu nejblizsiho ke kurzoru mysi
function nearestshapeline(mx,my) {
  var shape=actshape();
  if (!shape) return;
  if (shape->type!="rotate") return null;
  var pts=shape.forceSub("verteces");
  if (pts.count<=1) return null;
  var mini=0,mindist=shapelinedist(pts[0],pts[1],mx,my);
  directly for(var i=1;i<pts.count;i++) {
    var p1=pts[i],p2=pts[(i+1)%pts.count];
    var actdist=shapelinedist(p1,p2,mx,my);
    if (actdist<mindist) {
      mini=i;
      mindist=actdist;
    }
  }
  return mini;
}

function shapepmdist(ptxml,mx,my) {
  option directly;
  var dx=ltopx(shp_getx(ptxml))-mx,dy=ltopy(shp_gety(ptxml))-my;
  return (dx*dx+dy*dy).power(0.5);
}

//vrati index bodu nejblizsiho ke kurzoru mysi (v editaci tvaru)
function nearestshapept(mx,my) {
  var verteces=getshapeverteces(actshape());
  if (!verteces) return null;
  if (verteces.count==0) return null;
  var mini=0,mindist=shapepmdist(verteces[0],mx,my);
  directly for(var i=1;i<verteces.count;i++) {
    var actdist=shapepmdist(verteces[i],mx,my);
    if (actdist<mindist) {
      mini=i;
      mindist=actdist;
    }
  }
  shapeptdist=mindist;
  return mini;
}

function selectpolygon(x,y) {
  if (Application.shiftState.shift) {
    if (curalong) for (p in curalong-/clip.childs) {
      if (ModelProcs.pointInPolygon(ptolx(x),ptoly(y),p)) polygon=p;
    }
    changeview();
    return true;
  }
  return false;
}

function mdown(x,y,button,shift) {
  x=new Number(x);y=new Number(y);
  lastmx=x;lastmy=y;
  if (button=="left") {
    select (form->mode.cur) {
      -1:picmdown(x,y,button,shift);
      0:{
        if (!selectpolygon(x,y)) if (selline) {
          var pt=polygon.insert(selline+1);
          pt->x=roundx(ptolx(x));pt->y=roundy(ptoly(y));
          pt.name="point";
          selline=null;
        }
      }
      1:{
        if (!selectpolygon(x,y)) if (selpt && ptdist<maxdeletedist) {
          polygon[selpt].remove();
          selpt=null;
          changeview();
          return;
        }
      }
      2:{
        if (!selectpolygon(x,y)) if (selpt && ptdist<maxmovedist) {
          movingpt=polygon[selpt];
          var movx0=roundx(ptolx(x)),movy0=roundy(ptoly(y));
          movingpt->x=movx0;
          movingpt->y=movy0;
          return;    
        }
      }
      3:if (actinline()) {
        inlinept0=new (x=roundx(ptolx(x)),y=roundy(ptoly(y)));
        inlinesizing=shift.ctrl;
      }
      4:{
        if (Application.shiftState.shift) {
          for (st in colorizes) {
            var x1=ltopx(st->texx1),y1=ltopy(st->texy1),x2=ltopx(st->texx2),y2=ltopy(st->texy2);
            if (x1>x2) {var p=x1;x1=x2;x2=p;}
            if (y1>y2) {var p=y1;y1=y2;y2=p;}
            if (x>=x1 && x<=x2 && y>=y1 && y<=y2) selstamp=st;
          }
        } else {
          stamppt0=new (x=roundx(ptolx(x)),y=roundy(ptoly(y)));
          stampsizing=shift.ctrl;
        }
        changeview();
      }
      6:{
        movauxpt0=new (x=x,y=y);
      }
      7:{
        if (var verteces=getshapeverteces(actshape())) {
          var avx=0,avy=0,avz=0;
          directly for (v in verteces) {
            avx+=v->x;avy+=v->y;avz+=v->z;
          }
          if (verteces.count>0) {
            avx/=verteces.count;
            avy/=verteces.count;
            avz/=verteces.count;
          }
          var pt;
          if (selshapeline) pt=verteces.insert(selshapeline+1);else pt=verteces.add();
          pt->x=avx;pt->y=avy;pt->z=avz;
          shp_setx(pt,roundx(ptolx(x)));shp_sety(pt,roundy(ptoly(y)));
          pt.name="vertex";
          selshapeline=null;
        }
      }
      8:{
        if (selshapept && shapeptdist<maxdeletedist) {
          if (var verteces=getshapeverteces(actshape())) {
            verteces[selshapept].remove();
            selshapept=null;
            changeview();
            return;
          }
        }
      }
      9:{
        if (var verteces=getshapeverteces(actshape())) {
          if (selshapept && shapeptdist<maxmovedist) {
            movingshapept=verteces[selshapept];
            var movx0=roundx(ptolx(x)),movy0=roundy(ptoly(y));
            shp_setx(movingshapept,movx0);
            shp_sety(movingshapept,movy0);
            return;    
          }
        }
      }
    }
  } else {
    ismoving=true;
  }
}
function mmove(x,y) {
  x=new Number(x);y=new Number(y);
  if (form->mode.cur<0) {
    form->position.text="X="+ptolbmpx(x).round()+";Y="+ptolbmpy(y).round();
  } else {
    form->position.text="X="+roundx(ptolx(x))+";Y="+roundy(ptoly(y));
  }
  if (ismoving) {
    dx+=x-lastmx;
    dy+=y-lastmy;
    lastmx=x;lastmy=y;
    changeview();
  } else if (movingpt)  {
    option directly;
    var actx=roundx(ptolx(x)),acty=roundy(ptoly(y));
    movingpt->x=actx;
    movingpt->y=acty;
    lastmx=x;lastmy=y;
    changeview();
  } else if (movingshapept)  {
    option directly;
    var actx=roundx(ptolx(x)),acty=roundy(ptoly(y));
    shp_setx(movingshapept,actx);
    shp_sety(movingshapept,acty);
    lastmx=x;lastmy=y;
    changeview();
  } else if (picmmove(x,y)) {
  } else if (stamppt0 && selstamp) {
    option directly;
    var pt=new (x=roundx(ptolx(x)),y=roundy(ptoly(y)));
    var dx=pt->x-stamppt0->x;
    var dy=pt->y-stamppt0->y;
    if (stampsizing) {
      selstamp->texx2+=dx;
      selstamp->texy2+=dy;
    } else {
      selstamp->texx1+=dx;
      selstamp->texy1+=dy;
      selstamp->texx2+=dx;
      selstamp->texy2+=dy;
    }
    actpicpos();
    stamppt0=pt;
    changeview();
  } else if (inlinept0) {
    if (var inl=actinline()) {
      option directly;
      var pt=new (x=roundx(ptolx(x)),y=roundy(ptoly(y)));
      if (inlinesizing) {
        inl_setsx(inl,inl_getsx(inl)+pt->x-inlinept0->x);
        inl_setsy(inl,inl_getsy(inl)+pt->y-inlinept0->y);
      } else {
        inl_settx(inl,inl_gettx(inl)+pt->x-inlinept0->x);
        inl_setty(inl,inl_getty(inl)+pt->y-inlinept0->y);
      }
      inlinept0=pt;
      changeview();
    }
  } else if (movauxpt0) {
    option directly;
    var pt=new (x=x,y=y);
    curalong->edit_aux_x+=pt->x-movauxpt0->x;
    curalong->edit_aux_y+=pt->y-movauxpt0->y;
    movauxpt0=pt;
    changeview();
  } else if (form->mode.cur==7 || form->mode.cur==10) {
    selshapeline=nearestshapeline(x,y);
    changeview();
  } else if (form->mode.cur==8 || form->mode.cur==9) {
    selshapept=nearestshapept(x,y);
    changeview();
  } else if (polygon) {
    selpt=nearestpt(x,y);
    selline=nearestline(x,y);
    changeview();
  }
}
function mup(x,y,button) {
  picmup(x,y,button);
  select (button) {
    "right":{
      ismoving=false;
    }
    "left":{
      select (form->mode.cur) {
        5:{
          if (selline) {
            var pt=polygon[selline];
            if (var res=Window.inputBox("POEdit","$Insert-new-face-id",pt->faceid)) pt->faceid=res;
            selline=null;
          }
        }
        10:{
          if (selshapeline) {
            if (var vs=getshapeverteces(actshape())) {
              var pt=vs[selshapeline];
              if (var res=Window.inputBox("POEdit","$Insert-new-face-id",pt->faceid)) pt->faceid=res;
              selshapeline=null;
            }
          }
        }
      }
      if (stamppt0) {
        actpicpos();
        changeview();
      }
      movingpt=null;
      movingshapept=null;
      inlinept0=null;
      inlinesizing=false;
      stamppt0=null;
      stampsizing=false;
      movauxpt0=null;
    }
  }
}

function pmdist(ptxml,mx,my) {
  option directly;
  var dx=ltopx(ptxml->x)-mx,dy=ltopy(ptxml->y)-my;
  return (dx*dx+dy*dy).power(0.5);
}

function dist(x1,y1,x2,y2) {
  option directly;
  var dx=x1-x2,dy=y1-y2;
  return (dx*dx+dy*dy).power(0.5);
}

//vrati index bodu nejblizsiho ke kurzoru mysi
function nearestpt(mx,my) {
  if (polygon.count==0) return null;
  var mini=0,mindist=pmdist(polygon[0],mx,my);
  directly for(var i=1;i<polygon.count;i++) {
    var actdist=pmdist(polygon[i],mx,my);
    if (actdist<mindist) {
      mini=i;
      mindist=actdist;
    }
  }
  ptdist=mindist;
  return mini;
}

//vzdalenost bodu od usecky a,b - priblizne, jen pro ucely porovnani
function linedist(a,b,x,y) {
  var ax=ltopx(a->x),ay=ltopy(a->y),bx=ltopx(b->x),by=ltopy(b->y);
  return dist(ax,ay,x,y)+dist(bx,by,x,y)-dist(ax,ay,bx,by);
}

//vrati index bodu nejblizsiho ke kurzoru mysi
function nearestline(mx,my) {
  if (polygon.count<=1) return null;
  var mini=0,mindist=linedist(polygon[0],polygon[1],mx,my);
  directly for(var i=1;i<polygon.count;i++) {
    var p1=polygon[i],p2=polygon[(i+1)%polygon.count];
    var actdist=linedist(p1,p2,mx,my);
    if (actdist<mindist) {
      mini=i;
      mindist=actdist;
    }
  }
  return mini;
}

/*
function getpencolor() {
  return form->pencolor.text;
}
*/

function drawpolygon(cnv,p,vline) {
  directly for(var i=0;i<p.count;i++) {
    var p1=p[i],p2=p[(i+1)%p.count];
    var x1=ltopx(p1->x),y1=ltopy(p1->y),x2=ltopx(p2->x),y2=ltopy(p2->y);
    if (vline) {
      if (vline==i) cnv.randomLine(x1,y1,x2,y2);
    } else cnv.randomLine(x1,y1,x2,y2);
  }
}

function drawinline(cnv,inl) {
  var zip=zipobj.openChildPath(inl->name);
  var xml=new XMLNode();
  zip.loadXML("index.xml",xml);
  var model=new Model();
  model.load(xml);
  var kx=(ltopx(100)-ltopx(0))/100,ky=(ltopy(100)-ltopy(0))/100;
  model.drawProjection(cnv,form->along.cur,
    inl_getsx(inl)*kx,inl_getsy(inl)*ky,
    inl_gettx(inl)*kx+ltopx(0),inl_getty(inl)*ky+ltopy(0)
  );
}

function moveclip() {
  if (curalong) {
    var xml=new XMLNode();
    if (Application.runXMLDialog(Application.findResource("form.getxy"),xml)) {
      option directly;
      for (polygon in curalong-/clip) {
        for (pt in polygon) {
          pt->x+=xml->x;pt->y+=xml->y;
        }
      }
      changeview();
    }
  }
}

function movepolygon() {
  if (polygon) {
    var xml=new XMLNode();
    if (Application.runXMLDialog(Application.findResource("form.getxy"),xml)) {
      option directly;
      for (pt in polygon) {
        pt->x+=xml->x;pt->y+=xml->y;
      }
      changeview();
    }
  }
}

function randRect(cnv,x1,y1,x2,y2) {
//  Window.alert(x1&","&y1);
  cnv.randomLine(x1,y1,x2,y1);
  cnv.randomLine(x2,y1,x2,y2);
  cnv.randomLine(x2,y2,x1,y2);
  cnv.randomLine(x1,y2,x1,y1);
}

function drawselstamp(cnv,x1,y1,x2,y2,color,rad) {
  cnv.fg(color).penwi(1);
  cnv.ellipse(x1-rad,y1-rad,x1+rad,y1+rad);
  cnv.ellipse(x2-rad,y1-rad,x2+rad,y1+rad);
  cnv.ellipse(x2-rad,y2-rad,x2+rad,y2+rad);
  cnv.ellipse(x1-rad,y2-rad,x1+rad,y2+rad);
}

function drawauxpolygon(cnv,p,transp,dx,dy) {
  option directly;
  for(var i=0;i<p.count;i++) {
    var p1=p[i],p2=p[(i+1)%p.count];
    if (transp) {
      var x1=ltopx(p1->y)+dx,y1=ltopy(p1->x)+dy,x2=ltopx(p2->y)+dx,y2=ltopy(p2->x)+dy;
      cnv.randomLine(x1,y1,x2,y2);
    } else {
      var x1=ltopx(p1->x)+dx,y1=ltopy(p1->y)+dy,x2=ltopx(p2->x)+dx,y2=ltopy(p2->y)+dy;
      cnv.randomLine(x1,y1,x2,y2);
    }
  }
}


function paintaux(along,cnv,transp,dx,dy) {
  if (var clip=along-/clip) for (p in clip) {
    drawauxpolygon(cnv,p,transp,dx,dy);
  }
}

function getshapeverteces(shape) {
  if (!shape) return null;
  if (shape->type=="rotate") return shape-/verteces;
  return null;
}

function applydialog() {
  if (polygon) {
    if (var res=Window.inputBox("POEdit","$Type-solids-where-clip-should-apply",polygon->apply)) polygon->apply=res;
  }
}

function paint(cnv) {
  if (picture) {
    var w=picw*scalex*form->pp.W/2,h=pich*scaley*form->pp.H/2;
    picture.stretch(ltopx(picx0),ltopy(picy0)-h,w,h,cnv);
  }

/*  
  if (selpt0 && selpt1) {
    var x1=ltopbmpx(selpt0->x),y1=ltopbmpy(selpt0->y);
    var x2=ltopbmpx(selpt1->x),y2=ltopbmpy(selpt1->y);
    window.text=x1;
    cnv.bg("none").penwi(1);
    cnv.fg("red");
    cnv.rectangle(x1,y1,x2,y2);
    cnv.fg("lime");
    cnv.rectangle(x1+1,y1+1,x2-1,y2-1);
    cnv.fg("blue");
    cnv.rectangle(x1+2,y1+2,x2-2,y2-2);
  }
*/

  //osy
  cnv.fg("blue").penwi(1);
  cnv.line(0,ltopy(0),form->pp.W,ltopy(0));
  cnv.line(ltopx(0),0,ltopx(0),form->pp.H);

  if (form->auxhor.switched) {
    select (form->along.cur) {
      0:paintaux(smodel-/alongz,cnv,false,curalong->edit_aux_x,0);
      1:paintaux(smodel-/alongx,cnv,true,curalong->edit_aux_x,0);
      2:paintaux(smodel-/alongx,cnv,false,curalong->edit_aux_x,0);
    }
  }
  if (form->auxver.switched) {
    select (form->along.cur) {
      0:paintaux(smodel-/alongy,cnv,true,0,curalong->edit_aux_y);
      1:paintaux(smodel-/alongz,cnv,false,0,curalong->edit_aux_y);
      2:paintaux(smodel-/alongy,cnv,false,0,curalong->edit_aux_y);
    }
  }

  if (form->mode.cur==3) {
    cnv.fg("blue");
    for (inl in smodel-/inlines) drawinline(cnv,inl);
    cnv.fg("red");
    if (var inl=actinline()) drawinline(cnv,inl);
/*      if (var shape=modelModule.getshape(modelModule.findnode(inl->name))) {
        cnv.fg("blue").bg("red");
        var kx=(ltopx(100)-ltopx(0))/100,ky=(ltopy(100)-ltopy(0))/100;
        ModelProcs.drawProjection(cnv,shape,form->along.cur,
          inl_getsx(inl)*kx,inl_getsy(inl)*ky,
		      inl_gettx(inl)*kx+ltopx(0),inl_getty(inl)*ky+ltopy(0)
        );
        cnv.bg("none");
      }*/
/*      if (var shape=modelModule.getshape(modelModule.findnode(inl->name))) {
        cnv.fg("blue").bg("red");
        var kx=(ltopx(100)-ltopx(0))/100,ky=(ltopy(100)-ltopy(0))/100;
        ModelProcs.drawProjection(cnv,shape,form->along.cur,
          inl_getsx(inl)*kx,inl_getsy(inl)*ky,
		      inl_gettx(inl)*kx+ltopx(0),inl_getty(inl)*ky+ltopy(0)
        );
        cnv.bg("none");
      }*/
  }

  if (var clip=curalong-/clip) for (p in clip) {
    var vline=null;
    if (p==polygon && (form->mode.cur==0 || form->mode.cur==5)) vline=selline;
    drawpolygon(cnv,p,vline);
  }
/*
  //polygon
  directly for(var i=0;i<polygon.count;i++) {
    var p1=polygon[i],p2=polygon[(i+1)%polygon.count];
    var x1=ltopx(p1->x),y1=ltopy(p1->y),x2=ltopx(p2->x),y2=ltopy(p2->y);
//    if (selline && selline==i && form->mode.cur==0) cnv.fg("green").penwi(3);else cnv.fg(getpencolor()).penwi(1);
    if (form->mode.cur==0) {
      if (selline && selline==i) cnv.randomLine(x1,y1,x2,y2);
    } else {
      cnv.randomLine(x1,y1,x2,y2);
    }
  }
  cnv.penwi(1);
*/
  //stamps
  if (form->mode.cur==4) for (st in colorizes) {
    var x1=ltopx(st->texx1),y1=ltopy(st->texy1),x2=ltopx(st->texx2),y2=ltopy(st->texy2);
    randRect(cnv,x1,y1,x2,y2);
  }
  if (selstamp) {
    var st=selstamp;
    var x1=ltopx(st->texx1),y1=ltopy(st->texy1),x2=ltopx(st->texx2),y2=ltopy(st->texy2);
    drawselstamp(cnv,x1,y1,x2,y2,"red",csize2-1);
    drawselstamp(cnv,x1,y1,x2,y2,"green",csize2);
    drawselstamp(cnv,x1,y1,x2,y2,"blue",csize2+1);
  }

 
  //circles around verteces
  if (polygon) directly for(var i=0;i<polygon.count;i++) {
    var p=polygon[i];
    var x=ltopx(p->x),y=ltopy(p->y);
    cnv.fg("green").penwi(1);
    if (selpt && selpt==i) {
      if (form->mode.cur==1 && ptdist<maxdeletedist) cnv.penwi(3).fg("red");
      if (form->mode.cur==2 && ptdist<maxmovedist) cnv.penwi(2).fg("blue");
    }
    cnv.ellipse(x-csize2,y-csize2,x+csize2,y+csize2);
  }
  cnv.penwi(1);
  
  cnv.fg("red");
  for (shape in smodel-/shapes) {
    var cur=(shape===actshape());
    if (var verteces=getshapeverteces(shape)) {
      for(var i=0;i<verteces.count;i++) {
        var v1=verteces[i],v2=verteces[(i+1)%verteces.count];
        var x1=ltopx(shp_getx(v1)),y1=ltopy(shp_gety(v1));
        var x2=ltopx(shp_getx(v2)),y2=ltopy(shp_gety(v2));
        if (cur) {
          if (form->mode.cur==7 || form->mode.cur==10) {
            directly if (i==selshapeline) cnv.randomLine(x1,y1,x2,y2);
          } else {
            if (i==verteces.count-1) {
              cnv.fg("red").penwi(2).line(x1,y1,x2,y2).penwi(1);
            } else cnv.randomLine(x1,y1,x2,y2);
          }
          if (selshapept && selshapept==i) {
            if (form->mode.cur==8 && shapeptdist<maxdeletedist) cnv.penwi(3).fg("red");
            if (form->mode.cur==9 && shapeptdist<maxmovedist) cnv.penwi(2).fg("blue");
          }
          cnv.ellipse(x1-csize2,y1-csize2,x1+csize2,y1+csize2);
          cnv.penwi(1).fg("red");
        } else {
            if (i==verteces.count-1) {
              cnv.fg("blue").penwi(2).line(x1,y1,x2,y2).penwi(1);
            } else cnv.randomLine(x1,y1,x2,y2);
        }
      }
    }
  }
}

function doclose() {
  window.close();
}

