module poedTypes;

readonly types=new Store();

var gradtype;

function addType(type,handler) {
  types[type]=handler;
}

function editChild(childname,obj) {
  if (!obj.hasChild(childname)) return;
  var child=obj.openChild(childname);
  var x=new XMLNode();
  child.loadXML("index.xml",x);
  if (var type=poedTypes.types[x.name]) {
    type.edit(x,child);
    child.saveXML("index.xml",x);
  }    
}

function nameDialog(type,xml) {
  if (var name=Window.inputBox("$Question","$Name",type&"1")) {
    xml->name=name;
    return true;
  }
  return false;
}

function creating(type,xml) {
  if (types[type]) return types[type].creating(xml);
  return nameDialog(type,xml);
}
function created(type,xml,obj) {
  if (types[type]) types[type].created(xml,obj);
}
function edit(index,obj) {
  if (types[index.name]) types[index.name].edit(index,obj);
}
function loaded(index,obj,panel,form) {
  if (types[index.name]) types[index.name].loaded(index,obj,panel,form);
}
function unload(index,obj) {
  if (types[index.name]) types[index.name].unload(index,obj);
  gradtype=null;
}
function resname(index) {
  if (types[index.name]) return types[index.name].resname;
  return null;
}
function hasdata(index) {
  if (types[index.name]) return types[index.name].hasdata;
  return null;
}
function savedata(index,obj) {
  if (types[index.name]) types[index.name].savedata(index,obj);
}

class BaseType {
  function creating(xml) {return poedTypes.nameDialog(type,xml);}
  function created(xml,obj) {}
  function edit(xml,obj) {}
  function loaded(xml,obj,panel,form) {}
  function unload(index,obj) {}
  function savedata(index,obj) {}
  
  function editchild(childname,obj) {
    poedTypes.editChild(childname,obj);
  }
}

class AutoViewType extends BaseType {
  var modv;
  function autoviewloaded(xml,obj,panel,form) {
    if (obj.listChilds().split("\n").searchString("model.zip")>=0) {
      var child=obj.openChild("model.zip");
      var chx=new XMLNode();
      child.loadXML("index.xml",chx);
      this.modv=new ModelView(form->glv,form);
      modv.load(chx,child);
    }
  }
  function loaded(xml,obj,panel,form) {
    autoviewloaded(xml,obj,panel,form);
  }
  function edit(xml,obj) {
    editchild("model.zip",obj);
  }
}

class LocoType extends AutoViewType {
  var type="loco";
  readonly resname="poed.locofrm";
  readonly hasdata=true;
  
  constructor () {}
}
addType("loco",new LocoType());

