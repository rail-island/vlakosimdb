class SemaphoreType extends AutoViewType {
  var type="semaphore";
  readonly resname="poed.semfrm";
  readonly hasdata=true;
  
  var gradt;
  var lasttime;
  var gradsum;
  var gradvar,gradfrom,gradto;
  
  constructor () {}
  function loaded(xml,obj,panel,form) {
    autoviewloaded(xml,obj,panel,form);
    form.handler=this;
    gradsum=new Number(xml->gradtime);
  }
  function setstate(state) {
    if (gradsum>0) {
      gradfrom=modv.vars.getString("state");
      gradto=state;
      gradtype=this;
      lasttime=(system).clock;
      gradt=0;  
    } else {
      modv.vars.setString("state",state);
      modv.render();
    }
  }
  function grad() {
    if (gradt>1) {
      gradtype=null;
      modv.vars.setString("state",gradto);
      modv.render();
    } else {
      var dt=((system).clock-lasttime)/gradsum;
      lasttime=(system).clock;
      gradt+=dt;
      modv.vars.setGradString("state",gradfrom,gradto,gradt);
      modv.render();
    }
  }
}
addType("semaphore",new SemaphoreType());

