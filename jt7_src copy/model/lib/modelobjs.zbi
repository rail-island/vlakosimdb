class ModelProcs {
  ///polyedr-alg, clip? is xml, from it clipping polygon is loaded, can be null
//  static native void function pedrAlg(XMLNode output,clipx,clipy,clipz) [cmethod=runpedralg];
  static native void function polyedrToPolygons(XMLNode polyedr,XMLNode polygons) [cmethod=pedrtopolys];
  ///crooks prolyedr
  static native void function crook(XMLNode polyedr,string args) [cmethod=crookalg];
  ///draws projection
//  static native void function drawProjection(Canvas canvas,XMLNode shape,int dir,float sx,float sy,int tx,int ty) [cmethod=drawprojection];
  static native void function translate(XMLNode shape,float tx,float ty,float tz) [cmethod=s_translate cargs];
  static native void function scale(XMLNode shape,float sx,float sy,float sz) [cmethod=s_scale cargs];
  static native void function fillPattern(Canvas cnv,int x1,int y1,int x2,int y2,Picture pattern) [cmethod=fillPattern];
  ///generates rotation solid, can be used as input for PedrAlg
  static native void function generateRotateSolid(XMLNode pts,XMLNode pedr,int quality,XMLNode colorize) [cmethod=generateRotateSolid cargs];
  static native bool function pointInPolygon(float x,float y,XMLNode polygon) [cmethod=pointinpolygon cargs];
}

class GLView extends Control {
  native RenderContext property renderContext get;
  native void function render() [calllink];
}

class GLModelView extends GLView {
  native property model get set;//null:nic
  native ModelVariables property vars get set;
  native void function mapView(float seeAngle,float viewAngle,float scale,float dx,float dy) [calllink cmethod=mapview];
  native bool property lighting get [calllink] set [calllink];
  native void function setLight(float ambient,float diffuse,float specular,float ydir,float xzangle) [calllink cmethod=setlight];
}

class Model {
  native void function load(XMLNode xml,PersistentObject textures) [calllink cargs];
  native void function load(XMLNode xml) [calllink cargs];
  native void function drawProjection(Canvas canvas,int dir,float sx,float sy,float tx,float ty);
  native void function saveToVRML(string file) [calllink cmethod=savetovrml];
  native constructor () [cmethod=newmodel wantrt];
}

class Textures {
  static native void function define(string name,string file) [cmethod=definetexture];
  static native void function clear() [cmethod=cleartextures];
  static native string function textureFile(string texname) [cmethod=gettexturefile];
}

class ColorAlg {
  native void function addSide(int dir,float x1,float y1,float x2,float y2,string texname,bool transparent,string condidion,string rkoef,string gkoef,string bkoef,bool denylight) [calllink cmethod=addside];
  native void function addMaterialSide(int dir,float dx,float dy,float xscale,float yscale,string texname,bool transparent,string rkoef,string gkoef,string bkoef,bool transp,string condidion,bool denylight) [calllink cmethod=addmaterialside];
  native bool function run(XMLNode polygon) [calllink cargs];
  native constructor () [wantrt cmethod=newcoloralg];
}

class PedrAlg {
  ///xml must be polygon, adds clip in direction dir
  native void function clip(int dir,XMLNode polygon) [calllink cmethod=addclip cargs];
  ///runs, in output writes result polygon
  native void function run(XMLNode output) [cargs];
  ///runs, in output writes result polygon, input is chnaged polygon in pedr-form
  native void function modifyRun(XMLNode input,XMLNode output) [cargs];
  native constructor () [wantrt cmethod=newpedralg];
}

class StampAlg {
  native bool function run(XMLNode xml,XMLNode newpoly) [calllink cargs];
  native string property texture get [calllink] set [calllink];
  native int property dir get [calllink] set [calllink];
  native float property x1 get [calllink] set [calllink];
  native float property y1 get [calllink] set [calllink];
  native float property x2 get [calllink] set [calllink];
  native float property y2 get [calllink] set [calllink];
  native float property maxdist get [calllink] set [calllink];
  native bool property reflectt get [calllink] set [calllink];
  native bool property reflects get [calllink] set [calllink];
  native bool property transp get [calllink] set [calllink];
  native string property condition get [calllink] set [calllink];
  native bool property material get [calllink] set [calllink];
  ///only with materials
  native float property xscale get [calllink] set [calllink];
  ///only with materials
  native float property yscale get [calllink] set [calllink];
  ///red color component koeficient 0..1
  native string property rkoef get [calllink] set [calllink];
  ///green color component koeficient 0..1
  native string property gkoef get [calllink] set [calllink];
  ///blue color component koeficient 0..1
  native string property bkoef get [calllink] set [calllink];
  ///distance of stamp from stamped polygon
  native float property dist get [calllink] set [calllink];
  native constructor () [wantrt cmethod=newstampalg];
}

