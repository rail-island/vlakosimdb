<function help="1" static="0" name="createIsList">
<pars>
<param name="classtype"/>
</pars>
<code>
pushlocals
getprop classtype
xgetprop _is_list
jnx 0
pushnull
@0:
condnotjmp 1
pushnull
doret 1
@1:
pushlocals
getprop classtype
xgetprop @supername
jnx 2
pushnull
@2:
pushsys
cm op:get:index 1
pushlocals
setprop super
pop
pop
inlinearray 0
pushlocals
getprop classtype
setprop _is_list
pop
pushlocals
getprop super
condnotjmp 3
pushlocals
getprop super
pushthis
cm createIsList 1
pop
@3:
pushlocals
getprop classtype
pushlocals
getprop classtype
getprop _is_list
cm push 1
pop
pushlocals
getprop super
condnotjmp 4
pushlocals
getprop super
getprop _is_list
pushlocals
getprop classtype
getprop _is_list
cm addArray 1
pop
@4:

</code>
</function>
</class>
