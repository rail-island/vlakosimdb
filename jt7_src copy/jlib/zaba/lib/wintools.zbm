module winTools;

/*
class InterfaceForSDIFile {
  function save(filename);
  function load(filename);
  function modified();
} 
*/

class SDIFile {
  var intf,file;
  var modified=false;
  var filetype;
  constructor (intf,filetype) {this.intf=intf;this.filetype=filetype;}
  function save() {
    if (file) {
      intf.save(file);
      modified=false;
      return true;
    } else return saveAs();
  }
  function saveAs() {
    if (var res=SaveDialog.run("*."+filetype)) {
      file=res;
      intf.save(file);
      modified=false;
      return true;
    }
    return false;
  }
  function canNew() {
    if (canClose()) {
      file=null;
      modified=false;
      return true;
    }
    return false;
  }
  function openFile(filename) {
    file=filename;
    intf.load(file);
    modified=false;
  }
  function open() {
    if (canClose()) {
      if (var res=OpenDialog.run("*."+filetype)) {
        file=res;
        intf.load(file);
        modified=false;
      }
    }
  }
  ///return, whether the file can be closed, if user select it, it can save the file
  function canClose() {
//    Window.alert("canclose");
    if (modified || intf.modified()) {
      select (Window.msgbox("Soubor "+(file?file:"[Beze jmena]")+" zmenen, ulozit?","ync")) {
        "y":return save();
        "n":return true;
        "c":return false;
      }
    }
    return true;
  }
  ///sets modified flag to true
  function modify() {
    modified=true;
  }
  ///full file name or "[Untitled]", if file nas no name
  property file get {return file?file:"[Beze jmena]";}
}

class PrintDialog {
  readonly pages=[];
  readonly file=null;
  
  var form,win;
  var pagecnt;
  var ok;
  
  constructor () {}
  
  function fileprintchng() {
    form->file.enabled=form->printtofile.checked;
  }
  
  function paritysel(parity) {
    var pgs=form->pages.selected.split(";");
    pgs.makeInts();
    var res=[];
    for (i in pgs) if (i%2==new Number(parity)) res.push(i);
    form->pages.selected=res.join(";");
  }

  function print() {
    ok=true;
    win.close();
  }

  function cancel() {
    ok=false;
    win.close();
  }
  
  function browse() {
    var dlg=new SaveDialog();
    dlg.file=form->file.text;
    if (dlg.execute()) form->file.text=dlg.file;
  }
  
  function run(pageCount) {
    pagecnt=pageCount;
    form=new Form();
    win=form.loadWindow("form.printdialog");
    form.handler=this;
    form->file.enabled=false;
    form->pages.items=Array.sequence(1,pagecnt,1).join("\n");
    form->pages.selected=Array.sequence(0,pagecnt-1,1).join(";");
    win.showModal();
    pages=form->pages.selected.split(";");
    pages.makeInts();
    if (form->reverse.checked) pages.reverse();
    if (form->printtofile.checked) file=form->file.text;
    form.destroy();
    return ok;
  }  
}

class EditTextWindow {
  var form,win;
  function run(text) {
    form=new Form();
    win=form.loadWindow("form.editwin");
    form.handler=this;
    var fnt=new Font();fnt.name="Courier New";fnt.size="12";
    form->memo.font=fnt;
    form->memo.text=text;
    win.showModal();
    var res=form->memo.text;
    form.destroy();
    return res;
  }  
  constructor() {}
}

function editText(text) {
  var win=new EditTextWindow();
  return win.run(text);
}
