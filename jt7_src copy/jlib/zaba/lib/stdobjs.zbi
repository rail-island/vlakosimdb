system module stdlib;

class Object {
  function isInstanceOf(classType) asm "
pushparam 0
pushthis
cm getClass 0
getprop _is_list
cm searchRef 1
pushnull
flet
doret 1
";
  function typename() asm "
pushthis
cm getClass 0
getprop @classname
doret 1  
";
  property typename get asm "
pushthis
cm getClass 0
getprop @classname
doret 1  
";
}

class Number {
//  native function sin();
  native float operator +(Number right) [cmethod=op_add cargs];
  native float operator -(Number right) [cmethod=op_sub cargs];
  native float operator *(Number right) [cmethod=op_mul cargs];
  native float operator /(Number right) [cmethod=op_div cargs wantir];
  native float operator %(Number right) [cmethod=op_mod cargs wantir];
  native bool operator ==(Number right) [cmethod=op_eq cargs];
  native bool operator !=(Number right) [cmethod=op_neq cargs];
  native bool operator <(Number right) [cmethod=op_lt cargs];
  native bool operator >(Number right) [cmethod=op_gt cargs];
  native bool operator <=(Number right) [cmethod=op_let cargs];
  native bool operator >=(Number right) [cmethod=op_get cargs];
  native float operator ++() [cmethod=op_inc];
  native float operator --() [cmethod=op_dec];
  native float operator -() [cmethod=op_minus];
  native constructor(n) [cmethod=newnumber wantrt];
  
  ///sine
  native float function sin();
  ///cosine
  native float function cos();
  ///tanget
  native float function tan();
  ///arc sine
  native float function asin();
  ///arc cosine
  native float function acos();
  ///arc tangent
  native float function atan();
  ///natural logarithm
  native float function log();
  ///e powered to this
  native float function exp();
  ///this to exponent-th
  native float function power(float exponent);
  ///this>0?this:-this
  native float function abs();
  ///this>0:1,this==0:0,this<0:-1
  native float function sgn();
  ///rounds to nearest integer
  native int function round();
  ///random number from interval <0,1)
  static native float function rand() [cmethod=frand01];
  ///integer random number from <0,range-1>
  static native int function rand(int range) [cmethod=rangerand];
  static native int function compare(float value1,float value2) [cmethod=cmpnums];
}

class Math {
  static native float property PI get [cmethod=getpi];
  static native float property E get [cmethod=gete];
  static native float function min(...) [cmethod=minimum wantextra];
  static native float function max(...) [cmethod=maximum wantextra];
}

class MultiIndex {
  native int operator [int index] get set;
  native void function reverse();
  native void function add(int what);
  native constructor () [cmethod=newmultiindex wantrt];
  native constructor (Array a) [cmethod=newmultiindex wantrt];
  native Array function toArray();
  native function clone();
}

/**
Map to change characters (eg. uppercase...)
*/
class CharMap {
  ///eg. uppercase:abcdef...
  native string property source get set;
  ///eg. uppercase:ABCDEF...
  native string property target get set;
  native constructor () [cmethod=newcharmap wantrt];
}

class String {
  ///concatenation
  native string operator +(string right) [cmethod=op_add];
  ///exatly equals to right
  native bool operator ==(string right) [cmethod=op_eq];
  ///exatly equals to right
  native bool operator !=(string right) [cmethod=op_neq];
  ///case-insensitive compare
  native bool operator <(string right) [cmethod=op_lt];
  ///case-insensitive compare
  native bool operator >(string right) [cmethod=op_gt];
  ///case-insensitive compare
  native bool operator <=(string right) [cmethod=op_let];
  ///case-insensitive compare
  native bool operator >=(string right) [cmethod=op_get];
  ///converts obj to string
  native constructor (Object obj) [cmethod=newstring wantrt];
  ///length of string
  native int property length get [cmethod=length];
  ///returns char at index
  native string operator [int index] get [cmethod=charAt wantir];

  ///returns whether this has begin s
  native bool function beginsWith(string s);
  ///returns whether this has end s
  native bool function endsWith(string s);
  ///returns character at position index(idnexed from 0)
  native string function charAt(int index) [wantir];
  ///returns string <from,from+count)
  native string function substr(int from,int count) [wantir];
  ///returns string <from,end)
  native string function substring(int from,int end) [wantir];
  ///returns string converted to upper case
  native string function toUpperCase();
  ///returns string converted to lower case
  native string function toLowerCase();
  ///returns string without leading and ending white chracters
  native string function trim();
  ///returns index of substring substr, -1, if substr isn't in this
  native int function indexOf(string substr);
  ///returns index of substring substr, -1, if substr isn't in this
  native int function mapIndexOf(string substr,CharMap map);
  ///splits string in substrings
  native function split(string separator);
  ///saves string to file (EOLns are saved like in UNIX)
  native void function save(string file);
  ///returns whether this has begin s
  native bool function mapBeginsWith(string s,CharMap map);
  ///replaces first regex with 2-nd argument, 2-nd argument can contain \1,\2
  native string function replace(RegExp regex,string replace_with);
  ///replaces all regex with 2-nd argument, 2-nd argument can contain \1,\2
  native string function replaceAll(RegExp regex,string replace_with);
  ///replaces first regex with 2-nd argument, 2-nd argument can contain \1,\2
  native string function replace(string origin,string replace_with);
  ///replaces all regex with 2-nd argument, 2-nd argument can contain \1,\2
  native string function replaceAll(string origin,string replace_with);
  ///translates to local language
  native string function translate();
  ///returns string changed with CharMap
  native string function mapReplace(CharMap map);
  
  static native int function compare(string value1,string value2) [cmethod=cmpstrs];
}

class ArrayIterator {
  native function getValue();
  native function moveNext();
}

class Array {
  ///returns indexth element, if index is out of bounds, returns null
  native operator [int index] get [cmethod=getelem] set [cmethod=setelem wantir];
  ///adds arguments to the end of the array
  native void function push(...) [cmethod=additems wantextra cresult];

  ///length
  native Number property length get [cmethod=getcount cresult];
  ///synonymum to length
  native Number property count get [cresult];
  ///removes and returns the last element
  native function pop() [wantir];
  ///reverses all elements
  native void function reverse() [cresult];
  ///removes and returns the first element
  native function shift() [wantir];
  ///returns string elem1 separator elem2 ...
  native function join(InlineMethod func,String separator) [cargs wantrt];
  ///returns string elem1 separator elem2 ...
  native function join(String separator) [cargs wantrt];
  ///heap sort
  native void function sort(InlineMethod comparator) [wantir cmethod=inlsort];
  ///heap sort
  native void function sort(Object comparator) [wantir];
  ///alphabetic sort
  native void function sort();
  ///creates array from arguments
  native constructor() [wantextra cmethod=newarray wantrt];
  ///erases elements index,index+1,...,index+count-1
  native void function erase(int index,int count) [wantir];
  ///erases elements index
  native void function erase(int index) [wantir];
  ///inserts element what at position index
  native void function insert(int index,what);
  ///searches what, return inedx or -1, tests for what==items[i]
  native int function search(what);
  ///removes first object equal to what
  native void function remove(what);
  ///removes first object what
  native void function removeRef(what);
  ///changes order of items, newOrder must be permutation of count members
  native void function reOrder(MultiIndex newOrder) [wantir];
  
  ///removes all items
  native void function clear();
  
  native property last get;
  native function getIterator();
  
  ///shallow copy
  native function clone();
  ///shallow copy
  native void function assign(Array array);
  
  ///returns arithmetic sequence <low,high>
  static native Array function sequence(float low,float high,float step) [cmethod=newsequence wantrt];
  ///converts all members to integer
  native void function makeInts();
  ///converts all members to float
  native void function makeFloats();
  ///converts all members to string
  native void function makeStrings();
  ///converts all members to bool
  native void function makeBools();
  ///serchs item with condiotion true
  /**condition is inline function, which returns null, if item is not ok,
  or any value, if item is ok. Value is value of element, index is its index
  Example: [1,2,3].searchIf({if (value==2) return index;return null;}) returns 1
  */
  ///returns searched item or null
  native function searchIf(condition);
  ///returns searched item index or -1
  native function searchIfIndex(condition);
  ///returns returned expression or null
  native function searchIfValue(condition);
  ///rearches array for ref using operator ===(very fast)
  native int function searchRef(ref);
  ///rearches array for num
  native int function searchInt(int num);
  ///rearches array for str
  native int function searchString(string str);
  ///rearches array for num
  native int function searchFloat(float num);
  
  ///searchs extram, eg. searchExtrem({value},{extrem<=value}) returns minimum
  native function searchExtrem(InlineMethod extrem,InlineMethod forall);
  ///returns array of all items with true condition
  native Array function collect(InlineMethod condition);
  ///returns converted array (eg. [1,2].convert({value*2}) returns [2,4])
  native Array function convert(InlineMethod convertion);
  ///adds items from array
  native void function addArray(Array array);
  ///exchanges items index1 and index2
  native void function exchange(int idnex1,int index2) [wantir];
  ///if cannot do this, does nothing
  native bool function moveUp(int index);
  ///if cannot do this, does nothing
  native bool function moveDown(int index);
  ///returns subarray
  native Array function segment(int from,int len);
}

///n-dimensional array with fixed size
class Matrix {
  ///arguments are indexes to array
  /**arguments are indexes to array, number of arguments must be 
     equal to number of arguments put to constructor
  */
  native operator [...] get [wantextra wantir] set [wantargs wantir];
  ///arguments are dimensions
  /**
    arguments are dimensions, eg. new Matrix(4,3) creates 2-dimensional array
    with 4 rows(0..3) and 3 columns(0..2), valid indexing is [0..3,0..2]
  */
  native constructor(...) [wantextra cmethod=newmatrix wantrt];
  ///sets all elements to value
  native void function fill(value);
  ///searches what
  ///searches what, if found, returns MultiIndex, if not found, returns null
  native function search(what);
  native function clone();
}

class StringBuffer {
  native void function add(string what);
  native void function erase(int begin,int end);
  native constructor () [wantrt cmethod=newstringbuf];
}

class InlineMethod {
  native function "op:call" [wantextra wantir];
};

class System {
  native function createArray(...) [cmethod=createarray wantextra];
  native string function getStackTrace() [wantir];
  native function createDelegate(string name,object);
  native XMLNode property interpretState get [wantir];
  native operator ->(string name) get set;
  native operator [string name] get [cmethod=opgetprop];
  native function createInlineMethod(locals,obj,string name);
  ///returns seconds (can be used to measure time differences)
  native float property clock get;
  native int function command(string command);
  native function createInterruptFunction(obj,string name,...) [wantextra];
  function createIsList(classtype) {
    if (classtype?._is_list) return;
    super=system[classtype?."@supername"];
    classtype._is_list=[];
    if (super) this.createIsList(super);
    classtype._is_list.push(classtype);
    if (super) classtype._is_list.addArray(super._is_list);
  }
}

class Date {
  ///day,1..31
  native int property day get set;
  ///month,1..12
  native int property month get set;
  ///year,1900..
  native int property year get set;
  ///hours,0..23
  native int property hours get set;
  ///minutes,0..59
  native int property minutes get set;
  ///seconds,0..59
  native int property seconds get set;
  //seconds from 1.1.1970
  native int property ticks get set;
  //string, which can be sorted: 1976/05/23 12:21:43
  native string property sortString get;
  ///returns string as 27.9.2018
  native string property asString get set;
  ///creates instance with actual date and time
  native constructor () [cmethod=newdate wantrt];
  ///creates instance with date and time from value
  native constructor (string value) [cmethod=newdate wantrt];
  //fmt:@normal,@file,@sort
  native string function format(string fmt);
}

///represents ftile or directory name
class File {
	///returns, whether this is existing file
  native bool function isFile();
  ///returns, whether this is existing directory
  native bool function isDirectory();
  ///returns subitem in directory
  native File operator /(string name) [cresult];
  ///returns array of short names of files
  native function listFiles(string dir);
  ///root directory
  static native File property root get [cmethod=getrootdir wantrt];
  static native function list(string mask) [cmethod=fulllistfiles wantrt];
  ///creates this directory
  native void function mkdir();
  ///creates this directories
  native void function mkdirs();
  ///returns path relative to directory
  native File function relTo(string directory) [cresult];
  ///returns parent
  native File function getDirectory() [cresult];
  ///returns file name without path
  native File function getFile() [cresult];
  ///returns filename with changed extension
  native File operator %(string ext) [cresult];
  ///loads file as string
  native string function load();
  ///copies file
  native void function copyTo(string newname);
  ///renames file
  native void function renameTo(string newname);
  ///returns, whether file has extension ext
  native bool function hasExt(string ext);
  ///removes the file or directory
  native void function remove();
  ///creates new File object
  native constructor (string name) [cmethod=newfile wantrt];
}

class StoreIterator {
  native void function moveNext();
  native function getValue();
}

class Store {
  native operator ->(string name) get set;
  native constructor () [cmethod=newstore wantrt];
  native operator [string name] get [cmethod=idxgetprop] set [cmethod=idxsetprop];
  ///returns iterator, that enumerates all key(variable) names
  native function getIterator();
}

/**
Like Store, but is indexed by object reference
*/
class RefStore {
  ///assign null to delete variable
  native operator [ref] get [cmethod=getitem] set [cmethod=setitem];
  native constructor () [cmethod=newrefstore wantrt];
  ///returns Array of keys
  native Array property keys get;
}

class Exception {
  native constructor(string msg) [cmethod=newexception wantrt];
}

class VarListIterator {
  native void function moveNext();
  native function getValue();
}

class VarList {
  native string operator ->(string name) get set;
  native VarListIterator function getIterator();
  native void function clear();
  native void function eraseVar(string name);
  native constructor() [cmethod=newvarlist wantrt];
}

class XMLIterator {
  native function getValue();
  native void function moveNext();
}

class XMLNode {
  ///readonly access to child elements
  native XMLNode operator [XMLPath index] get [cmethod=getsubpath cresult];
  ///readonly access to child elements
  native XMLNode operator [MultiIndex index] get [cargs wantir cmethod=nodeAt];
  ///by-name child access
  native XMLNode operator [String index] get [cmethod=getSub cresult cargs];
  ///element name
  native string property name get set;
  ///element text
  native string property text get set;
  ///readonly random access to child elements
  native XMLNode operator [int index] get [cmethod=at cresult];
  ///readonly by-name access to child elements
  native XMLNode function getSub(string name) [cresult];
  ///readonly random access to child elements
  native XMLNode function at(int index) [cresult];
  ///adds new child element, returns link to it
  native XMLNode function add() [cresult];
  ///adds new child element named name, returns link to it
  native XMLNode function add(string name) [cresult];
  ///if exists child name, returns it, else adds new
  native XMLNode function forceSub(string name) [cresult];
  ///inserts new child element before element pos, returns link to it
  native XMLNode function insert(int pos) [cresult];
  ///erase index-th child
  native void function eraseAt(int index);
  ///erases first child name
  native void function eraseSub(string name);
  ///deep copy from src
  native void function assign(XMLNode src) [cargs];
  ///number of child elements
  native int property count get;
  ///number of attributes
  native int property varCount get;
  ///then index-th attribute value(from 0)
  native string function varAt(int index);
  ///then index-th attribute name(from 0)
  native string function varNameAt(int index);
  ///returns value of attribute name
  native string function getVar(string name);
  ///sets value of attribute name to value
  native void function setVar(string name,string value);
  ///loads XML from file(full path expected) and returns new XML
  static native XMLNode function load(string file) [cmethod=loadxml cresult];
  native void function sort(InlineMethod comparator) [wantir cmethod=inlsort];
//  native XMLNode function sort(string indexes) [cresult];
  ///read-write access to attributes
  native string operator -> (string name) get [cmethod=getVar] set [cmethod=setVar];
  ///readonly access to child elements
  native XMLNode operator -/ (string name) get [cmethod=getSub cresult];
  ///creates empty XML node
  native constructor () [cmethod=newXMLNode wantrt];
  ///saves XML to file(full path expected)
  native void function save(string file);
  ///deletes all attributes and childs
  native void function clear();
  ///loads XML from file and replaces old contents of XMLNode
  native void function load(string file);
  ///save all variables from vars
  native void function saveVars(VarList vars);
  ///loads all variables from vars, deletes old vars
  native void function loadVars(VarList vars);
  ///deletes all variables
  native void function clearVars();
  ///deletes all subs
  native void function clearSubs();
  ///erases variable name
  native void function eraseVar(string name);
  ///returns XMLNode at index or throws exception, if no exists
  native XMLNode function nodeAt(MultiIndex index) [cargs wantir];
  ///if true, chenges in right are reflected in this
  native bool operator ==(XMLNode right);
  ///if true, chenges in right are not reflected in this
  native bool operator !=(XMLNode right);
  
  ///equal by content
  native bool function equalTo(XMLNode xml) [cargs];
  ///equal by content, not sorted
  native bool function weekEqualTo(XMLNode xml) [cargs];
  ///returns, whether XML element has specified attribute name
  native bool function isVar(string name);
  ///returns, whether XML element has child name
  native bool function isSub(string name);
  ///returns parent XMLNode or null
  native XMLNode property parent get;      
  ///removes node from XML tree
  native void function remove();
  ///returns array of childs
  native Array property childs get;
  ///returns array of all variable names
  native Array property varNames get;
  ///returns, whether exists object path
  native bool function exists(XMLPath path);
  ///exchanges two childs, returns, whether change is valid
  native bool function exchange(int index1,int index2);

  native XMLIterator function getIterator();
  native function clone();
}

class XMLPath {
  native constructor (string path) [cmethod=newxmlpath wantrt];
}

//callable object
class Delegate {
  //calls the saved method
  native function "op:call" [wantextra wantir];
//  native function "op:call" [directcall cmethod="calldelegate"];
}

/**
Alphabetic table sort
*/
class QuickSorter {
  native void function push(...) [wantextra];
  native MultiIndex function sort();
  native constructor() [cmethod=newquicksorter wantrt];
}

class CharMixer {
  native void function compileFile(string file) [safecall wantir];
  native string function run() [safecall wantir];
  native VarList property globals get;
  native constructor () [cmethod=newcharmixer wantrt];
  native Object operator ->(string name) get [cmethod=getvar] set [cmethod=setvar];
  native bool function hasSub(string name);
  native string function callSub(string name);
}

class RegExp {
  ///compiles new regular expression from regex
  native constructor (string regex) [wantrt cmethod=newregexp];
  ///runs regular expression on text, returns match result or null
  native RegResult function match(string text);
  ///synonyme to match
  native RegResult operator *(string text) [cmethod=match];
}

class RegResult {
  native string function replace(string replace_string);
  ///returns n-th substring of last matched text
  native string operator [int index] get [cmethod=getstr];
  ///returns matched text
  native string property match get;
  ///returns text to match
  native string property text get;
  ///returns begin of index-th substring
  native int function begin(int index);
  ///returns end of index-th substring
  native int function end(int index);
  ///returns substring count
  native int property count get;
}

class InterruptFunction {
  native function "op:call";
  native bool property finished;
}