module XMLTools;

/*
Termonology:ancestor+difference=descendant
*/

function combine(anc,dif) {
  var res=anc.clone();
  combine_res(res,dif);
  return res;
}

function combine_res(res,dif) {
  for(var i=0;i<dif.varCount;i++) res.setVar(dif.varNameAt(i),dif.varAt(i));
  for (child in dif) {
    if (res.isSub(child.name)) {
      var my=res.getSub(child.name);
      combine_res(my,child);
    } else {
      res.add().assign(child);
    }
  }
}

function difference(des,anc) {
  var res=new XMLNode();
  difference_res(res,des,anc);
  return res;
}

function difference_res(res,des,anc) {
  res.name=des.name;
  for(var i=0;i<des.varCount;i++)
    if (des.varAt(i)!=anc.getVar(des.varNameAt(i)))
      res.setVar(des.varNameAt(i),des.varAt(i));
      
  for (child in des) {
    if (!child.weekEqualTo(anc.getSub(child.name)))
      difference_res(res.add(),child,anc.getSub(child.name));
  }
}

