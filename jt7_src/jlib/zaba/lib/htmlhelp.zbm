module HTMLHelp;

class HHSource extends TreeSource {
  var xml;
  function getCount() {return xml.count;}
  function getText() {return xml->text;}
  function getNodeAt(index) {return new HHSource(xml[index]);}
  constructor(xml) {this.xml=xml;}
}

var xml;

var dir;
var form;
var window;

var list=[];

class ListItem {
  readonly name,xml;
  constructor (name,xml) {this.name=name;this.xml=xml;}
}

function makelist() {
  var res=new StringBuffer();
  for (l in list) {res.add(l.name);res.add("\n");}
  return new String(res);
}

function addxml(xml) {
  list.push(new ListItem(xml->text,xml));
  for (c in xml) addxml(c);
}

function wantwin() {
  if (!window) {
    form=new Form();
    form.handler=this;
    window=form.loadWindow("hh.window");
  }
}

function run(file) {
  wantwin();
  showfile(file);
  window.show();
  treeclick();
}

function showfile(file) {
  dir=(new File(file)).getDirectory();
  list=[];
  xml=new XMLNode();
  xml.load(file);
  addxml(xml);
  list.sort({String.compare(left.name,right.name)});
  form->tree.source=new HHSource(xml);
  form->list.items=makelist();
}

function gotopic(path) {
  var active=new MultiIndex();
  var parent=xml;
  for (item in path.split("/")) {
    for(var i=0;i<parent.count;i++) {
      if (parent[i].name==item) {
        active.add(i);
        parent=parent[i];
        break;
      }
    }
  }
  form->tree.active=active;
  treeclick();
}

function run(file,path) {
  wantwin();
  showfile(file);
  gotopic(path);
  window.show();
}

function loadtopic(href) {
  form->html.text=(dir/href).load();
}

function golink(href) {
  if (href.beginsWith("topic:")) {
    gotopic(href.substr(6,href.length-6));
  } else if (href.beginsWith("main:")) {
    showfile(dir/href.substr(5,href.length-5));
    treeclick();
  } else {
    loadtopic(href);
  }
}

function findpic(src) {
  var pic=new Picture();
  pic.load(dir/src);
  form->html.searchedPicture(src,pic);
}

function treeclick() {
  var a=form->tree.active;
  var elem=xml[a];
  if (elem->topic!="") loadtopic(elem->topic);
}

function listclick() {
  var l=list[form->list.cur];
  var elem=l.xml;
  if (elem->topic!="") loadtopic(elem->topic);
}

