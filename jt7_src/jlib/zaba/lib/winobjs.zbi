  native void function save(XMLNode xml) [calllink cargs];
  native int function getHeight() [calllink cmethod=getheight];
  native int function getWidth(string text) [calllink cmethod=getwidth];
}

///bitmap
class Picture {
  native void function load(string file) [safecall calllink];
  native void function save(string file) [safecall calllink];
  native Canvas property canvas get;
  native void function draw(int x,int y,Canvas cnv) [cargs];
  native void function stretch(int x,int y,int w,int h,Canvas cnv) [cargs];
  native void function stretchRectangle(int x,int y,int w,int h,int srcx,int srcy,int srcw,int srch,Canvas cnv) [cargs];
  native void function hflip() [calllink];
  native void function vflip() [calllink];
  native void function transp() [calllink];
  native int property W get [calllink cmethod=getw] set [calllink cmethod=setw];
  native int property H get [calllink cmethod=geth] set [calllink cmethod=seth];
  native void function invert() [calllink];
  native Picture function clone();
  native constructor () [cmethod=newpicture wantrt];
}

///global methods
class ApplicationClass {
  ///runs application, can be called only once
  native void function run() [cmethod=runapp wantir];
  ///ends the message loop
//  native void function exit() [cmethod=exitapp];
  native void function exit() [calllink cmethod=quit];
//  ///runs Auto-Design on xml
//  static native void function runAD(XMLNode xml) [cmethod=runAD cargs];
  ///loads resource XML with forms,menus ...;files are \n separated
  native void function loadResource(string files) [cmethod=loadresource];
  ///options XML-automatically saved and loaded, setOptionFile was called
  native XMLNode property options get [cmethod=getopts cresult];
  ///adds search path for images
  native void function addSearchPath(string path) [cmethod=addSearchPath];
  ///sets the option file and loads options, options are also automatically saved
  native void function setOptionFile(string file) [cmethod=setOptionFile];
  ///runs XML dialog, returns success
  native bool function runXMLDialog(XMLNode dialog,XMLNode data) [cmethod=runxmldialog cargs];
  ///finds resource, if doesn't exist, error
  native XMLNode function findResource(string name) [cmethod=findresource wantir];
  ///runs Settings dialog, returns success
  native bool function runSettingsDialog(string dialog,XMLNode data) [cmethod=runsettingsdialog cargs];
//  native string property title get [cmethod=getapptitle] set [cmethod=setapptitle];
  native string property title get [calllink] set [calllink];
  native property systemMenu get [cmethod=getsysmenu wantrt] set [cmethod=setsysmenu];//MenuItem|null
//  static native WaitWindow property wait get [cmethod=getwaitwin];
  native property handler get set;
//  native property handler get [cmethod=getapphandler wantrt] set [cmethod=setapphandler wantrt];
//  native string property onIdle get set;
  native string property onIdle get [calllink cmethod=getidle] set [calllink cmethod=setidle];
  native string property onDesktopMouseDown get [calllink cmethod=getdesktopmousedown] set [calllink cmethod=setdesktopmousedown];
  native string property onDesktopMouseUp get [calllink cmethod=getdesktopmouseup] set [calllink cmethod=setdesktopmouseup];
  native string property onDesktopMouseMove get [calllink cmethod=getdesktopmousemove] set [calllink cmethod=setdesktopmousemove];
  native int property desktopW get [calllink cmethod=getdesktopw];
  native int property desktopH get [calllink cmethod=getdesktoph];
  native ShiftState property shiftState get;
}        

