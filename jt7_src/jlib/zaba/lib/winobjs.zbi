///when you paint, it is on this object 
class Canvas {
  ///draws line from [x1,y1] to [x2,y2]
  native function line(int x1,int y1,int x2,int y2) [calllink retthis];
  ///draws rectangle
  native function rectangle(int x1,int y1,int x2,int y2) [calllink cargs retthis cmethod=rect];
  ///draws ellipse enclosed in specified rectangle
  native function ellipse(int x1,int y1,int x2,int y2) [calllink cargs retthis];
  ///sets foreground color, used for lines and shapes, colors like in html
  native function fg(string color) [link retthis];
  ///sets background color, used for filling shapes, colors like in html
  native function bg(string color) [link retthis];
  ///draws text at [x,y], this is left-top corner of text
  native function text(int x,int y,string str) [calllink retthis];
  ///returns text width written with actua;l font
  native int function textwi(string str) [calllink];
  ///returns text height written with actua;l font
  native int function texthi(string str) [calllink];
  ///selects font for this canvas
  native function font(Font font) [link retthis];
  ///selects pen width, 0:minimal width
  native function penwi(int wi) [calllink retthis];
  ///draws frame around specified rectangle, type:"raised" | "sunken"
  native function drawFrame(int x1,int y1,int x2,int y2,string type) [retthis];
  ///draws text centered in rectangle, flags:bool centerx,centery,clip
  native function centerText(int x1,int y1,int x2,int y2,string text,Store flags) [retthis];
  native function centerText(int x1,int y1,int x2,int y2,string text) [retthis];
  native Canvas function nextBand(int hi) [link];
  ///type:"optional":if band is first or last on page, on can be omited
  native Canvas function nextBand(int hi,string type) [link];
  ///draws radio button centered to [x,y]
  native function drawRadio(int x,int y,bool checked) [calllink retthis cmethod=drawradio];
  ///draws check box centered to [x,y]
  native function drawCheck(int x,int y,bool checked) [calllink retthis cmethod=drawcheck];
  ///access to pixels
  native string operator [int x,int y] get [cmethod=getpixel] set [cmethod=putpixel];
  ///draws rectangle with random color
  native void function drawSelection(int x1,int y1,int x2,int y2);
  ///draws line with random color
  native void function randomLine(int x1,int y1,int x2,int y2) [cmethod=randomline calllink];
  ///mode="surface"|"border", color==border color
  native void function floodFill(int x,int y,string mode,string color) [cmethod=floodfill];
}

