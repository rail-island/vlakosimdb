/**
TextCanvas has two modes:simple, where it only writes the text and with
limited page height, where it throws expception from methods text and wrap,
if the page height limit is broken. Data after last call of method flush are lost.
*/

class TextCanvas {
  native constructor(Canvas cnv,int wi) [cmethod=newtextcanvas wantrt];
  native constructor(Canvas cnv,int wi,int pagehi) [cmethod=newtextcanvas wantrt];
  native void function text(string s) [wantir];
  native void function font(Font font) [calllink cargs];
  native void function wrap() [calllink];
  native void function flush() [calllink];
  ///fixed x-coord, can wrap
  native void function textElemX(int space,int x,string s) [wantir];
  ///cannot divide in more lines
  native void function textElem(int space,string s) [wantir];
}

