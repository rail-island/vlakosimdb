class Printer {
  native constructor () [cmethod=newprinter wantrt];
  native Canvas function getInfo() [link cresult calllink cmethod=getinfo];
  native void function loadProperties(XMLNode xml) [cargs cmethod=loadprops calllink];
  native void function saveProperties(XMLNode xml) [cargs cmethod=saveprops calllink];
  native int property pghi get [calllink];
  native int property pgwi get [calllink];
  native Canvas function beginPage() [calllink cresult cmethod=beginpage];
  native void function endPage() [calllink cresult cmethod=endpage];
  native Font function makeFont(Font src) [calllink cmethod=createprnfont cargs cresult];///vyrobi tiskarnovy font
  native void function setup() [calllink];
  native void function detailSetup() [calllink cmethod=detailsetup];
  native void function beginDoc(string title);
  native void function beginFileDoc(string title,string file) [calllink cmethod=begindoc];
  native void function endDoc() [calllink cmethod=enddoc];
//  static native PrinterDevices property devices get;
  native void function destroy() [link];
  ///pixels per milimeter int X axis direction
  native float property ppmmx get [calllink];
  ///pixels per milimeter int Y axis direction
  native float property ppmmy get [calllink];
}

///console-like window
class Console {
  ///prints all arguments
  native void function print(...) [wantextra];
  ///prints all arguments and goes to new line
  native void function println(...) [wantextra];
  ///return readed line
  native string function readln();
  ///closes virtual or system console, if console is system, is opened by calling print,println,readln
  native void function close() [calllink];
  ///creates and opens virtual console
  native constructor () [cmethod=newconsole wantrt];
  ///waits for key down(this key has no effect)
  native void function wait() [calllink];
  ///returns system console
  static native Console property std get [cmethod=getstdcon wantrt];
  native void function destroy() [link];
}

///pressed key with constrol keys(eg. Alt+F1)
class Key {
  ///compares to string representation of key(eg. alt+ctrl+f1==Ctrl+Alt+F1)
  native bool operator ==(string key);
  native bool operator !=(string key);
  ///creates new key object from string like ctrl+f2
  native constructor (string keyname) [cmethod=newkey wantrt];
  ///returns, whether key contains shift
  native bool property shift get;
  ///returns, whether key contains alt
  native bool property alt get;
  ///returns, whether key contains control
  native bool property ctrl get;
  ///returns, whether key contains left shift
  native bool property lshift get;
  ///returns, whether key contains right shift
  native bool property rshift get;
  ///returns key name (if this==Alt+M, key is M)
  native string property key get;
}

class ShiftState {
  ///returns, whether key contains shift
  native bool property shift get;
  ///returns, whether key contains alt
  native bool property alt get;
  ///returns, whether key contains control
  native bool property ctrl get;
  ///returns, whether key contains left shift
  native bool property lshift get;
  ///returns, whether key contains right shift
  native bool property rshift get;
}

class Timer {
  ///creates new timer, new is not running
  native constructor() [cmethod=newtimer wantrt];
  ///delegate, is called every interval, if timer is running
  native property handler get set;
  ///starts timer, every iterval handler is called
  native void function start() [calllink cmethod=restart];
  ///stops timer, handler is never called before start is called
  native void function stop() [calllink];
  ///timer is running or waiting to run
  native bool property running get [calllink cmethod=isrunning];
  ///interval in seconds
  native float property interval get [calllink] set [calllink];
  ///simple timer, is called only ones
  static native void function timer(float secs,handler,...) [wantextra cmethod=newsimpletimer];
}

