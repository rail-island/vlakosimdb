library module winobjs;

class Component {
}

///Base class of all controls
class Control extends Component {
  native int property X get [link] set [link];
  native int property Y get [link] set [link];
  native int property W get [link] set [link];
  native int property H get [link] set [link];
  ///deletes control object
  native void function destroy() [link];
  native void function show() [calllink];
  native void function hide() [calllink];
  native bool property visible get [calllink] set;
  native bool property enabled get [calllink] set [calllink];
  native Control property parent get set;
  native Font property font get set;
  native void function loadProps(XMLNode xml,Form form) [calllink cmethod=loadprops cargs];
  native void function saveData(XMLNode xml) [calllink cmethod=savedata cargs];
  native void function loadData(XMLNode xml) [calllink cmethod=loaddata cargs];
  native void function clearChilds() [calllink cmethod=clearchilds];
  native string property tag get [calllink] set [calllink];
}

///represents any Window
class Window extends Component {
  ///shows simple message window
  ///shows simple message window, every argument is on separate line
  static native function alert(...) [cmethod=alert wantextra wantrt];
  ///title bar of window
  native string property text get [calllink] set [calllink];
  native constructor () [cmethod=newwindow wantrt];
  native void function showModal() [link];
  native void function show() [link];
  ///if this method is called during onclose event, window is not closed
  native void function denyClose() [calllink cmethod=denyclose];
  native void function close() [calllink];
  native string property style get [calllink] set [calllink];
  native int property X get [link] set [link];
  native int property Y get [link] set [link];
  native int property W get [link] set [link];
  native int property H get [link] set [link];
  ///shows messagebox, returns first char of pressed button in lowercase
  /**
  Buttons:ync:yes-no-cancel,arf:abort-retry-fail,o:ok,oc:ok-cancel,yn:yes-no
  */
  static native string function msgbox(string msg,string buttons) [cmethod=zbmsgbox wantir];
  ///shows message window, buttons are ';' delimited button names, returns index of selected button or -1
  static native int function msgwin(string title,string msg,string buttons) [cmethod=zbmsgwin];
  ///returns inputed text of null, when cancel was pressed
  static native function inputBox(string title,string msg,string def) [cmethod=zbinputbox wantrt];
  //pixels per milimeter on screen
  static native float property ppmmx get [cmethod=getppmmx];
  //pixels per milimeter on screen
  static native float property ppmmy get [cmethod=getppmmx];
  
  native void function loadData(XMLNode xml) [calllink cargs cmethod=loaddata];
  native void function saveData(XMLNode xml) [calllink cargs cmethod=savedata];
}

///non-visible component, maintains event-calls, loading from XML ...
class Form extends Component {
  native function loadWindow(string name) [wantrt];
  native constructor () [cmethod=newform wantrt];
  native constructor (Component owner) [cmethod=newform wantrt];
  native property handler get set;
  native Component function search(string name) [cresult calllink];
  native Component operator ->(string name) get [cresult calllink cmethod=search];
  native void function destroy() [link];
}

///Button control
class Button extends Control {
  ///caption of button
  native string property text get [calllink] set [calllink];
