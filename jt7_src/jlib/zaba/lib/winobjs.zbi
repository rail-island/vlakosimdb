  ///makes linear page distrubution
  native PageDistribution function completeLines(Array ofsx,Array ofsy);
  native int property pageHi get [calllink cmethod=getpghi];
  native int property pageWi get [calllink cmethod=getpgwi];
  native LogPage operator [int index] get [cmethod=getpage];
  native LogPage function addPage();
  native int property count get;
  native LogPage property last get;
  ///returns page number, which contains pane
  native int function searchPane(Pane pane) [cargs calllink cmethod=searchpane];
}

