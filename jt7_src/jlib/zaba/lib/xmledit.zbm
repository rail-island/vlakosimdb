module XMLEditModule;

class XMLEditorSource extends TreeSource {
  readonly xml;
  function getCount() {return xml.count;}
  function getText() {return xml.name;}
  function getNodeAt(index) {return new XMLEditorSource(xml[index]);}
  constructor(xml) {this.xml=xml;}
}

readwrite clipbrd;

class XMLEditor {
  var form,ctrl;
  var selectednode;
  var doc;

  function init(xml,ctrl,owner) {
    this.ctrl=ctrl;
    this.doc=xml;
    this.selectednode=null;
    if (owner) this.form=new Form(owner);else this.form=new Form();
    if (ctrl) ctrl.loadProps(Application.findResource("ctrl.xmleditor"),form);
    else this.ctrl=form.loadWindow("form.xmleditor");
    form.handler=this;
    form->tree.source=new XMLEditorSource(xml);
  }
  
  constructor(xml,ctrl,owner) {init(xml,ctrl,owner);}
  
  function showModal() {
    ctrl.showModal();
  }
  
  function destroy() {
    form.destroy();
    form=null;
  }

  function selected() {return selectednode;}
  
  function updateselectednode() {
    var act=form->tree.active;
    if (act) selectednode=doc[act];
    else selectednode=null;
  }
  
  function copytoclipboard() {
    if (var sel=selected()) XMLEditModule.clipbrd=sel.clone();
  }
  
  function pastefromclipboard() {
    if (var sel=selected()) {
      if (XMLEditModule.clipbrd) sel.add().assign(XMLEditModule.clipbrd);
      updatetree();
      onchange();
    }
  }

  function insattr() {
    if (var sel=selected()) {
      if (var name=Window.inputBox("Dotaz","Jméno atributu(musí být identifikátor)?","Nove_jmeno")) {
        savevars();
        sel.setVar(name,"");
        loadvars();
        onchange();
      }
    }
  }
  
  function eraseattr() {
    form->props.eraseVar();
  }
  
  function savevars() {
    if (var sel=selected()) {
      var v=new VarList();
      form->props.save(v);
      sel.loadVars(v);
      onchange();
    }  
  }
  
  function loadvars() {
    if (var sel=selected()) {
      var v=new VarList();
      sel.saveVars(v);
      form->props.load(v);
    }  
  }

  function findnode(name) {
    var path=new XMLPath(name);
    if (doc.exists(path)) return doc[path];
    return null;
  }
  
  function clearchilds() {
    savevars();
    if (var sel=selected()) {
      sel.clearSubs();
      updatetree();
    }
    loadvars();
    onchange();
  }
  
  function treeclick() {
    savevars();
    updateselectednode();
    loadvars();
  }
  
  function updatetree() {
    form->tree.update();
  }
  
  function clear() {
    doc.clear();
    doc.name="empty";
    updatetree();
    onchange();
  }
  
  function erase() {
    if (var sel=selected()) {
      if (sel!=doc) sel.remove();
      updatetree();
      onchange();
    }
  }
  
  function rename() {
    if (var sel=selected()) {
      if (var text=Window.inputBox("Dotaz","Nové jméno, bez háèkù, èárek a mezer?",sel.name)) sel.name=text;
      updatetree();
      onchange();
    }
  }
  
  function mkdir() {
    if (var sel=selected()) {
      if (var text=Window.inputBox("Dotaz","Jméno, bez háèkù, èárek a mezer?","name")) {
        var xml=sel.add();
        xml.name=text;
        updatetree();
      }
    }
  }
  
  function onchange() {
  }
}

function run(xml) {
  var editor=new XMLEditor(xml,null,null);
  editor.showModal();
  editor.destroy();
}
