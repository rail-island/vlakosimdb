class ModelVariables {
  native constructor () [wantrt cmethod=newmodelvariables];
  native void function setFloat(string name,float value) [cmethod=setvar calllink];
  native void function setString(string name,string value) [cmethod=setvar calllink];
  native void function setGradString(string name,string from,string to,float t) [cmethod=setgradvar calllink];
  native string function getString(string name) [cmethod=svar calllink];
}

class jtObject {
  native string property name get;
  native string property title get;
  native string property path get;
  native string property author get;
  native PersistentObject property data get;
  
  static native function load(PersistentObject data) [cmethod=loadjtobject wantrt];
}

class jtCab extends jtObject {
  native void function render(RenderContext rc,XMLNode xml);
}

class jtBuilding extends jtObject {
  native int property W get;
  native int property H get;
}

class jtSmoke extends jtObject {
  native SmokeInstance function create();
}

class SmokeInstance {
  native void function render(RenderContext rc);
  native void function iterate(float deltatime,float x,float y,float z,float vx,float vy,float vz);
  native void function translate(float x,float y,float z);
}

class jtStation extends jtObject {
  native StationInstance function complete(int trc,int trl);
}

class jtBusStop extends jtObject {
}

class jtBridge extends jtObject {
  native BridgeInstance function complete(int length);
}

class jtTunnel extends jtObject {
}

class jtDepo extends jtObject {
}

class jtAircraft extends jtObject {
}

class StationInstance {
  native void function render(float x,float y,float z,RenderContext rc,int dir);
}

class BridgeInstance {
  native void function render(float x,float y,float z,RenderContext rc,int dir);
}

class jtMachine extends jtObject {
  native float property maxSpeed get;
  native float property weight get;
  native float property power get;
}

class jtMotocar extends jtObject {
  native float property maxSpeed get;
  native float property weight get;
  native float property power get;
}

class RenderContext {
}
