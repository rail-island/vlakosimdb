module RRBuildModule;

include module trackBuildModule;

var bld;
var isdepo;
var rstdir;//null, pri staveni 0..3
var rstpt0;//prvni bod u stanice (store, ->x,->y)
var semtypes=[];
var buildsem;

var formname="jtycon.rrbldfrm";
var tracktype="rail";

function initwindow() {
  semtypes=game.semaphoreTypes;
  form->sems.items=semtypes.join({value.title},"\n");
}

function erase(x,y) {
  game.eraseRail(x,y);
}

function mdown(button) {
  select (button) {
    "left":{
      if (buildsem) {
        game.buildSemaphore(game.mapX,game.mapY,semtypes[form->sems.cur]);
      } else if (rstdir) {
        if (rstpt0) {
          if (isdepo) game.buildDepo(game.mapX,game.mapY,rstpt0->x,rstpt0->y,rstdir);
          else game.buildRStation(game.mapX,game.mapY,rstpt0->x,rstpt0->y,rstdir);
          clear();
        } else {
          rstpt0=new (x=game.mapX,y=game.mapY);
        }
      } else if (trackmdown(button)) {
      } else {
        bld=new RRBuilder(game.mapX,game.mapY);
        bld.dHeight=dhi;
        bld.mode=gethimode();
      }
    }
    "right":{
      if (rstdir) {
        rstdir++;
        if (rstdir>=4) rstdir=0;
      } else trackmdown(button);
    }
  }
}

function mup(button) {
  select (button) {
    "left":{
      if (bld) {
        bld.build(game.mapX,game.mapY);
        bld=null;
      } else trackmup(button);
    }
    "right":{
      trackmup(button);
    }
  }
}

function mmove() {
  if (bld) {
    if (game.mouseInMiddle) bld.build(game.mapX,game.mapY);
  } else trackmmove();
}

function onpaint() {
  if (bld) {
    game.drawComplexCursor(bld.X,bld.Y,"aqua");
  } else if (buildsem) {
    game.drawCursor(game.mapX,game.mapY,"lime");
  } else if (rstdir) {
     if (rstpt0) {
       var x1=rstpt0->x,y1=rstpt0->y,x2=game.mapX,y2=game.mapY;
       if (x1>x2) {var p=x1;x1=x2;x2=p;}
       if (y1>y2) {var p=y1;y1=y2;y2=p;}
       game.drawCustomCursors(x1,y1,x2,y2,Cursors.rstation,rstdir);
     } else {
       game.drawCustomCursor(game.mapX,game.mapY,Cursors.rstation,rstdir);
     }
  } else if (trackonpaint()) {
  } else {
    game.drawCustomCursor(game.mapX,game.mapY,Cursors.railroad,0);
  }
}

function clear() {
  trackclear();
  bld=null;
  rstdir=null;
  rstpt0=null;
  buildsem=false;
  isdepo=false;
}

function rrbuild() {
  JTycon.state=this;
  clear();
}

function blddepo() {
  JTycon.state=this;
  clear();
  rstdir=0;
  isdepo=true;
}

function bldsem() {
  JTycon.state=this;
  clear();
  buildsem=true;
}

function bldrst() {
  JTycon.state=this;
  clear();
  rstdir=0;
}

