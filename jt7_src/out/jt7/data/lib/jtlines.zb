module linesModule;

readonly lines=[];
readonly lineTypes=new Store();

var form,win;

class JTWayPoint {
  readonly x,y;
  constructor(x,y) {this.x=x;this.y=y;}
  constructor(xml) {
    x=new Number(xml->x);
    y=new Number(xml->y);
  }
  function save(xml) {
    xml->x=x;xml->y=y;
  }
}

class JTLineStation {
  readonly waypoints=[];
  readonly station;
  constructor(station) {this.station=station;}
  function save(xml) {
    xml->name=station.name;
    for (wp in waypoints) {
      var xw=xml.add("waypoint");
      wp.save(xw);
    }
  }  
  function load(xml) {
    for (wx in xml) {
      var wp=new JTWayPoint(wx);
      waypoints.push(wp);
    }
  }
}

class JTLine {
  readonly proxy=new ProxyGameObject();
  readonly stations=[];
  var form,win;
  var addingwp;
  var addingst;
  property name get {return proxy.name;}

  var waypoints=[];

  //VIRTUAL
  var formname;
  var stationtype;
  function initform() {}
  function savespec(xml) {}
  function loadspec(xml) {}
  
  operator [index] get {return stations[index].station;}
  property count get {return stations.count;}

  var renamewin;
  var renameform;
  function dorename() {
    if (renameform) return;
    renameform=new Form();
    renamewin=renameform.loadWindow("jtycon.renamewin");
    renameform.handler=this;
    renameform->nameedit.text=proxy.name;
    renamewin.show();
  }
  function renameok() {
    proxy.name=renameform->nameedit.text;
    renameclose();
  }
  function renameclose() {
    renameform.destroy();
    renameform=null;renamewin=null;
  }
  
  function changest() {
    updatewps();
  }
  function changewp() {
    if (var wp=waypoints[form->waypoints.cur]) {
      game.lookAt(wp.x,wp.y);
    }
  }
  
  function show() {
    if (form) return;
    form=new Form();
    form.handler=this;
    JTycon.state=this;
    win=form.loadWindow(formname);
    updatestats();
    win.show();
    JTWinManager.place(win);
    initform();
  }
  function onclose() {
    JTWinManager.closed(win);
    JTycon.state=null;
    form.destroy();
    form=null;
    win=null;
  }
  function addst() {
    JTycon.state=this;
    addingst=true;
  }
  function delst() {
    var cur=form->stations.cur;
    if (cur>=0) stations.erase(cur);
    updatestats();
  }
  function upst() {
    if (stations.moveUp(form->stations.cur)) form->stations.cur--;
    updatestats();
  }
  function downst() {
    if (stations.moveDown(form->stations.cur)) form->stations.cur++;
    updatestats();
  }
  
  function addwp() {
    addingwp=true;
    JTycon.state=this;
  }
  function delwp() {
    var cur=form->waypoints.cur;
    if (cur>=0) waypoints.erase(cur);
    updatewps();
  }
  function upwp() {
    if (waypoints.moveUp(form->waypoints.cur)) form->waypoints.cur--;
    updatewps();
  }
  function downwp() {
    if (waypoints.moveDown(form->waypoints.cur)) form->waypoints.cur++;
    updatewps();
  }
  
  function updatestats() {
    form->stations.items=stations.join({value.station.name},"\n");
    updatewps();
  }
  function updatewps() {
    if (var st=stations[form->stations.cur]) waypoints=st.waypoints;else waypoints=[];
    if (form->waypoints) form->waypoints.items=waypoints.join({value.x&","&value.y},"\n");
  }
  function onpaint() {
    if (addingst) game.drawCursor(game.mapX,game.mapY,"lime");
    if (addingwp) game.drawCursor(game.mapX,game.mapY,"yellow");
    if (form->waypoints) if (var wp=waypoints[form->waypoints.cur]) game.drawCursor(wp.x,wp.y,"red");
  }
  function mdown(button) {
    if (addingwp) {
      if (var st=stations[form->stations.cur]) st.waypoints.push(new JTWayPoint(game.mapX,game.mapY));
      addingwp=false;
      updatewps();
    } else if (addingst) {
      addingst=false;
      if (var st=game.staticAt(game.mapX,game.mapY)) {
        if (st is stationtype) {
          stations.push(new JTLineStation(st));
        }
      }
      updatestats();
    }
//    JTycon.state=null;
  }
  function mup(button) {
  }
  function mmove() {
  }
  function save(xml) {
    var sts=xml.add("stations");
    xml->name=proxy.name;
    for (st in stations) if (st.station.valid) {
      var x=sts.add("station");
      st.save(x);//->name=st.name;
    }
    savespec(xml);
  }
  function load(xml) {
    stations=[];
    proxy.name=xml->name;
    for (st in xml-/stations) if (var obj=JTycon.game.objectFromName(st->name)) {
      var s=new JTLineStation(obj);
      s.load(st);
      stations.push(s);
    }
    loadspec(xml);
  }
}

function show() {
  if (form) return;
  form=new Form();
  form.handler=this;
  win=form.loadWindow("jtycon.linesfrm");
  updatelines();
  win.show();
  JTWinManager.place(win);
}

function updatelines() {
  if (form) {
    form->lines.items=lines.join({value.proxy.name},"\n");
  }
}

function addline(type) {
  var line=new type();
  lines.push(line);
  updatelines();
}

function addrline() {
  addline(JTRLine);
}
function addaline() {
  addline(JTALine);
}
function addmline() {
  addline(JTMLine);
}

function eraseline() {
  if (form && form->lines.cur>=0) lines.erase(form->lines.cur,1);
  updatelines();
}

function editline() {
  if (form && form->lines.cur>=0) lines[form->lines.cur].show();
}

function newgame() {
  lines=[];
}

function loadgame(ar) {
  lines=[];
  var xml=new XMLNode();
  ar.loadXML("lines.xml",xml);
  for (lx in xml) {
    if (var type=lineTypes[lx.name]) {
      var line=new type();
      line.load(lx);
      lines.push(line);
    }
  }
}

function savegame(ar) {
  var xml=new XMLNode();
  xml.name="lines";
  for (line in lines) {
    line.save(xml.add("line"));
  }
  ar.saveXML("lines.xml",xml);
}

function onclose() {
  JTWinManager.closed(win);
  form.destroy();
  form=null;
  win=null;
}


function updatelines() {
  for (m in JTycon.game.mobiles) {
    if (m is Train) m.priority=m->line.proxy->priority;
  }
}
