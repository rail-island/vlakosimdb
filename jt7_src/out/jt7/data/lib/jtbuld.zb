module buldozereModule;

var game;
var down;

function run() {
  JTycon.state=this;
  game=JTycon.game;
}

function onpaint() {
  game.drawCustomCursor(game.mapX,game.mapY,Cursors.buldozere,0);
//  game.drawComplexCursor(game.mapX,game.mapY,"red");
}

function erase() {
  if (var st=game.staticAt(game.mapX,game.mapY)) {
    st.remove();
  } else {
    game.eraseRail(game.mapX,game.mapY);
    game.eraseRoad(game.mapX,game.mapY);
  }
}

function mdown(button) {
  down=true;
  erase();
}

function mup(button) {
  down=false;
}

function mmove() {
  if (down) erase();
}

