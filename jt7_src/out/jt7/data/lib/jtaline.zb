module ALineModule;

requires module linesModule;

class JTALine extends JTLine {
  formname="jtycon.alinefrm";
  stationtype=Airport;
  
  constructor () {
    proxy.name="L 1";
    proxy->vehicle="";
    proxy->waittime=2;
  }

  function changetype() {
    proxy->vehicle=game.aircraftTypes[form->types.cur].name;
  }
  
  function initform() {
    form->types.items=game.aircraftTypes.join({value.title},"\n");
    form->types.cur=game.aircraftTypes.searchIfIndex({value.name==proxy->vehicle});
  }
  function savespec(xml) {
    xml.name="aline";
    xml->vehicle=proxy->vehicle;
  }
  function loadspec(xml) {
    proxy->vehicle=xml->vehicle;
  }
}
linesModule.lineTypes->aline=JTALine;

