module RRTemplateModule;

var game;
var form,win;
var tpls;
var adding;
var dir8=0;
var pt0;

var renamewin;
var renameform;

function run() {
  JTycon.state=this;
  game=JTycon.game;
  tpls=Application.options.forceSub("RRtemplates");
  if (win) return;
  form=new Form();
  win=form.loadWindow("jtycon.rrtemplatefrm");
  form.handler=this;
  updatetpls();
  win.show();
  JTWinManager.place(win);
}

function updatetpls() {
  form->tpls.items=tpls.childs.join({value->name},"\n");
}

function onclose() {
  JTWinManager.closed(win);
  form.destroy();
  if (JTycon.state===this) JTycon.state=null;
  form=null;
  win=null;
}

function newtpl() {
  adding=true;pt0=null;
  JTycon.state=this;
}

function usetpl() {
  adding=false;pt0=null;
  JTycon.state=this;
}

function remove() {
  if (var tpl=tpls.childs[form->tpls.cur]) {
    tpl.remove();
    updatetpls();
  }
}

function rename() {
  if (var tpl=tpls.childs[form->tpls.cur]) {
    if (renameform) return;
    renameform=new Form();
    renamewin=renameform.loadWindow("jtycon.renamewin");
    renameform.handler=this;
    renameform->nameedit.text=tpl->name;
    renamewin.show();
  }
}
function renameok() {
  if (var tpl=tpls.childs[form->tpls.cur]) {
    tpl->name=uniquename(renameform->nameedit.text);
    renameclose();
    updatetpls();
  }
}
function renameclose() {
  renameform.destroy();
  renameform=null;renamewin=null;
}

function makerect() {
  var x1=pt0->x,y1=pt0->y,x2=game.mapX,y2=game.mapY;
  if (x1>x2) {var p=x1;x1=x2;x2=p;}
  if (y1>y2) {var p=y1;y1=y2;y2=p;}
  return new (x1=x1,y1=y1,x2=x2,y2=y2);
}

function onpaint() {
  if (pt0) {
    var r=makerect();
    game.drawCustomCursors(r->x1,r->y1,r->x2,r->y2,Cursors.add,0);
  } else {
    if (adding) {
      game.drawCustomCursor(game.mapX,game.mapY,Cursors.add,0);
    } else {
      if (var tpl=tpls.childs[form->tpls.cur]) game.drawRRTemplate(game.mapX,game.mapY,dir8,tpl);
      else game.drawCustomCursor(game.mapX,game.mapY,Cursors.error,0);
    }
  }
}

function mdown(button) {
  if (adding) {
    if (pt0 && button=="left") {
      var r=makerect();
      var xml=tpls.add("template");
      game.storeRRTemplate(r->x1,r->y1,r->x2-r->x1+1,r->y2-r->y1+1,xml);
      xml->name=uniquename("tpl");
      updatetpls();
      pt0=null;
    } else {
      if (button=="left") pt0=new (x=game.mapX,y=game.mapY);
    }
  } else {
    if (button=="right") {
      dir8++;
      if (dir8>=8) dir8=0;
    }
    if (button=="left") {
      if (var tpl=tpls.childs[form->tpls.cur]) {
        game.useRRTemplate(game.mapX,game.mapY,dir8,tpl);
      }
    }
  }
}

function uniquename(name) {
  if (name!="tpl" && !tpls.childs.searchIf({value->name==name})) return name;
  var i=1;
  var childs=tpls.childs;
  while (childs.searchIf({value->name==name&i})) i++;
  return name&i;
}

function mup(button) {
}

function mmove() {
}

