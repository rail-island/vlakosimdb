<?xml version="1.0" encoding="Windows-1250"?>
<data>

<window rep.name="form.shapeeditor" layout="hlist" state="max" closeonesc="1" text="Shape3D Editor" menu="menu.shapeeditor">
  <place name="xmledit"/>
  <place name="glv"/>
</window>

<menubar rep.name="menu.shapeeditor">
  <popup text="XML">
    <do text="$Clear-all" shortcut="ctrl+n" onclick="newfile()"/>
    <do text="$Save" shortcut="ctrl+s" onclick="savefile()"/>
    <do text="$Load" shortcut="ctrl+o" onclick="loadfile()"/>
    <separator/>
    <do text="$Make-subdirectory" shortcut="f7" onclick="mkdir()"/>
    <do text="$Delete" shortcut="f8" onclick="erase()"/>
    <do text="$Rename" shortcut="f6" onclick="rename()"/>
    <do text="$Clear-current" shortcut="f9" onclick="clearchilds()"/>
    <separator/>
    <do text="$Quit" onclick="quit()"/>
  </popup>
  <popup text="$Data">
    <do text="$Add-attribute" shortcut="ctrl+i" onclick="insattr()"/>
    <do text="$Remove-attribute" shortcut="ctrl+u" onclick="eraseattr()"/>
    <do text="$Refresh" shortcut="f5" onclick="review()"/>
  </popup>
  <popup text="$Edit">
    <do text="$Copy" shortcut="ctrl+c" onclick="copytoclipboard()"/>
    <do text="$Insert" shortcut="ctrl+v" onclick="pastefromclipboard()"/>
    <popup text="$Other-keys">
      <do text="$Copy" shortcut="ctrl+insert" onclick="copytoclipboard()"/>
      <do text="$Insert" shortcut="shift+insert" onclick="pastefromclipboard()"/>
    </popup>
    <do text="$Edit" shortcut="f4" onclick="edit()"/>
    <do text="$Run-script" shortcut="f5" onclick="runscript()"/>
  </popup>
  <popup text="$Add">
    <do text="$Polygon" shortcut="ctrl+p" onclick="insdata('polygon')"/>
    <do text="$Polyline" shortcut="ctrl+l" onclick="insdata('polyline')"/>
    <do text="$Vertex" shortcut="f2" onclick="insdata('vertex')"/>
    <do text="$Inline-object" onclick="insdata('inline')"/>
    <do text="$Rotate" onclick="insdata('rotate')"/>
    <do text="$Translate" onclick="insdata('translate')"/>
    <do text="$Scale" onclick="insdata('scale')"/>
    <do text="$Options" onclick="insdata('settings')"/>
  </popup>
</menubar>

</data>
