<?xml version="1.0" encoding="Windows-1250"?>
<data>
<place name="modelview" rep.name="model.view" layout="vlist">
  <panel ll.vsize="25" layout="hflow">
    <trackbar name="see" onchange="changeview()" min="5" max="90" cur="0" h="25" w="100" hint="$See-angle"/>
    <trackbar name="view" onchange="changeview()" min="0" max="360" cur="0" h="25" w="100" hint="$View-angle"/>
    <trackbar name="scale" onchange="changeview()" min="0" max="80" cur="30" h="25" w="100" hint="$Scale" focused="1"/>
    <speedbutton onclick="savetovrml()" h="25" w="25" image="save.bmp" hint="$Save-as VRML"/>
    <speedbutton onclick="changeview()" switch="1" h="25" w="40" text="$Light" name="light"/>
    <trackbar name="ambient" onchange="changeview()" min="0" max="30" cur="30" h="25" w="60" hint="AMBIENT"/>
    <trackbar name="diffuse" onchange="changeview()" min="0" max="30" cur="30" h="25" w="60" hint="DIFFUSE"/>
    <trackbar name="specular" onchange="changeview()" min="0" max="30" cur="30" h="25" w="60" hint="SPECULAR"/>
  </panel>
  <glmodelview name="glview" onmousedown="mdown(x,y,button)" onmousemove="mmove(x,y)" onmouseup="mup(button)" onpaintgl="onrender()"/>
</place>

