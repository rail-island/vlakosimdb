<?xml version="1.0" encoding="Windows-1250"?>
<data>
<window clienth="400" clientw="530" rep.name="model.simpleedfrm" menu="model.simpleedmenu" layout="1" text="$Simple-model" state="max" autoload="simple_edit">
  <pager name="pager" onchange="changepager()">
    <page text="$Clip-and-color" layout="vlist">
      <panel ll.vsize="25" layout="hflow">
        <speedgroup name="mode" onchange="setmode()" cur="2">
          <speedbutton text="+" hint="$Add-point" h="20" w="20"/>
          <speedbutton text="-" h="20" hint="$Delete-point" w="20"/>
          <speedbutton text="&lt;-&gt;" hint="$Move-point" h="20" w="20"/>
          <speedbutton text="INL" hint="$Place-of-inline-object" h="20" w="20"/>
          <speedbutton text="ST" hint="$Place-stamps" h="20" w="20"/>
          <speedbutton text="FID" hint="$Face-identifiers" h="20" w="20"/>
          <speedbutton text="AUX" hint="$Move-auxiliary-shapes" h="20" w="20"/>
          <speedbutton text="R+" hint="$Add-point-to-rotate-solid" h="20" w="20"/>
          <speedbutton text="R-" h="20" hint="$Delete-point-from-rotate-solid" w="20"/>
          <speedbutton text="R&lt;-&gt;" hint="$Move-point-of-rotate-solid" h="20" w="20"/>
          <speedbutton text="RFID" hint="$Rotate-solid - $face-identifiers" h="20" w="20"/>
        </speedgroup>
        <trackbar name="scale" onchange="changescale()" min="0" max="80" cur="30" h="25" w="100" hint="$Scale"/>
        <edit name="jumpx" onchange="changejump()" w="40" hint="$Edit-jump X"/>
        <edit name="jumpy" onchange="changejump()" w="40" hint="$Edit-jump Y"/>
    <!--    <edit name="pencolor" onchange="changeview()" w="50" hint="Barva, kterou se kreslí polygon(anglicky)"/>-->
        <panel h="21" w="100" layout="1">
          <label name="position"/>
        </panel>
        <speedgroup name="along" onchange="alongchange()" hint="$View-side" cur="0">
          <speedbutton text="X" w="20" h="20"/>
          <speedbutton text="Y" w="20" h="20"/>
          <speedbutton text="Z" w="20" h="20"/>
        </speedgroup>
        <place w="10"/>
        <packedlist name="colorize" h="20" w="120" onchange="colorizechange()" hint="$Color-image-hint" cur="0"/>
<!--
        <speedgroup name="colorize" onchange="colorizechange()" hint="$Color-side" cur="0">
          <speedbutton text="INC" w="30" h="20"/>
          <speedbutton text="DEC" w="30" h="20"/>
        </speedgroup>
-->
        <packedlist name="inlines" h="20" w="80" items="" onchange="inlinechange()" hint="$Inline-object-edit"/>
        <packedlist name="shapes" h="20" w="80" items="" onchange="shapeschange()" hint="$Shape"/>
<!--
        <packedlist name="along" h="20" w="50" items="X;Y;Z" onchange="alongchange()" hint="$View-side" cur="0"/>
        <packedlist name="colorize" h="20" w="50" items="INC;DEC" onchange="colorizechange()" hint="$Color-side" cur="0"/>
        <packedlist name="inlines" h="20" w="80" items="" onchange="inlinechange()" hint="$Inline-object-edit"/>
-->
        <speedbutton text="H" w="20" h="20" switch="1" name="auxhor" onclick="changeview()"/>
        <speedbutton text="V" w="20" h="20" switch="1" name="auxver" onclick="changeview()"/>
      </panel>
      <paintbox name="pp" onpaint="paint(canvas)" onmousedown="mdown(x,y,button,shift)" onmousemove="mmove(x,y)" onmouseup="mup(x,y,button)" doublebuffer="1" onresize="changeview()"/>
      <rep.include name="ctrl.bmpdrawtoolbar"/>
<!--      
      <place ll.vsize="50" layout="hlist">
        <speedbutton ll.hsize="50" name="color" onclick="choosecolor()"/>
        <place layout="vlist">
          <place layout="hflow" ll.vsize="28">
            <speedgroup name="drawmode" cur="-1" onchange="setdrawmode()">
              <speedbutton image="pen.bmp" hint="$Pen" h="25" w="25"/>
              <speedbutton image="dropper.bmp" hint="$Dropper" h="25" w="25"/>
              <speedbutton image="drawrectangle.bmp" hint="$Draw-rectangle" h="25" w="25"/>
              <speedbutton image="select.bmp" hint="$Select" h="25" w="25"/>
              <speedbutton image="moveselect.bmp" hint="$Move-selection" h="25" w="25"/>
              <speedbutton image="fillrectangle.bmp" hint="$Fill-rectangle-width-pattern-from-clipboard" h="25" w="25"/>
            </speedgroup>
            <speedbutton image="copy.bmp" hint="$Copy" h="25" w="25" onclick="copybmp()"/>
            <speedbutton image="open.bmp" hint="$File-to-clipboard" h="25" w="25" onclick="loadbmp()"/>
            <speedbutton image="ok.bmp" hint="$Place-OK" h="25" w="25" onclick="okblit()"/>
          </place>
          <colortable root="colortable" rows="1" cols="32" name="colortable" onselect="selectcolor(x,y,button)"/>
        </place>
      </place>
-->
    </page>
    <page text="$Model" layout="1">
      <place name="modelview"/>
    </page>
    <page text="$Colorize" layout="1" name="colorizespage">
      <rep.include name="ctrl.colorize"/>
    </page>
<!--
    <page text="$Crook" layout="1">
      <memo name="crookmemo"/>
    </page>
-->
    <page text="$Inline-objects" layout="1" name="inlinepage">
      <rep.include name="ctrl.inlineobjs"/>
    </page>
    <page text="$Shapes" layout="1" name="shapepage">
      <rep.include name="ctrl.shapes"/>
    </page>
    <page text="$Noise" layout="1" name="noisepage">
      <rep.include name="ctrl.noise"/>
    </page>
<!--
    <page text="$Materials" layout="1" name="materialpage">
      <rep.include name="ctrl.materials"/>
    </page>
    <page text="$Stamps" layout="1" name="stampspage">
      <rep.include name="ctrl.stamps"/>
    </page>
-->
  </pager>
</window>

<menubar rep.name="model.simpleedmenu">
  <popup text="$File">
    <do text="$Refresh" shortcut="f5" onclick="render()"/>
    <do text="$Delete-faces ..." onclick="editdeletefaces()"/>
    <do text="$Crook ..." onclick="editcrook()"/>
    <do text="$Quit" shortcut="esc" onclick="close()"/>
  </popup>
  <popup text="$Polygon">
    <do text="$Add" shortcut="ctrl+n" onclick="addpoly()"/>
    <do text="$Delete" shortcut="f8" onclick="erasepoly()"/>
    <do text="$Clear $polygon" onclick="clearpolygon()"/>
    <do text="$Next" shortcut="tab" onclick="togglenextpolygonorstamp()"/>
    <do text="$Previous" shortcut="shift+tab" onclick="toggleprevpolygonorstamp()"/>
    <do text="$Move" onclick="movepolygon()"/>
    <do text="$Move-all" onclick="moveclip()"/>
    <do text="$Apply-clip" onclick="applydialog()" shortcut="f2"/>
  </popup>
  <popup text="$Texture">
    <do text="$Options" onclick="setimage()"/>
    <do text="$Undo" shortcut="ctrl+z" onclick="undoimage()"/>
    <do text="$Flip-clipboard-horizontally" onclick="selpichflip()"/>
    <do text="$Flip-clipboard-vertically" onclick="selpicvflip()"/>
    <do text="$Resize-clipboard" onclick="selresize()"/>
  </popup>
</menubar>
</data>
