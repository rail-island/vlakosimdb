<?xml version="1.0" encoding="Windows-1250"?>
<data>
<window clienth="400" clientw="530" closeonesc="0" menu="poed.mainmenu" name="window1" onclose="onclose()" onok="" position="center" rep.name="poed.mainwin" state="max" text="POEdit" layout="vlist">
  <panel ll.vsize="25" layout="hflow">
    <packedlist name="filter" 
      items="$All;$Railroad-vehicle;$Building;$Railroad;$Depo;$Railway-station;$Tunnel;$Bridge;$Other" 
      tag="all;loco;building;railroad;depo;rstation;tunnel;bridge;other" hint="$Filter" w="100" h="20" onchange="filterchanged()"/>
    <panel w="200" layout="1"><label name="path"/></panel>
  </panel>
  <place layout="hlist">
    <listbox name="objelems" ll.hsize="30%" sdp.multicol="1" sdp.colwi="100" onchange="changedobj()"/>
    <place layout="vlist">
      <panel name="objpanel"/>
      <place ll.vsize="20" layout="hlist">
        <button text="$OK" onclick="btok()"/>
        <button text="$Cancel" onclick="btcancel()"/>
        <button text="$Into" onclick="btin()"/>
        <button text="$Out" onclick="btout()"/>
      </place>
    </place>
  </place>
</window>

<menubar rep.name="poed.mainmenu">
  <popup text="$Object">
    <do text="$New..." onclick="newobject()" shortcut="ctrl+n"/>
    <do text="$Edit" shortcut="f4" onclick="edit()"/>
    <do text="$Edit-comment" shortcut="ctrl+e" onclick="edittcomment()"/>
    <do text="$Store-to-repositary" onclick="storetorepositary()"/>
    <do text="$Edit XML" shortcut="shift+f4" onclick="editxml()"/>
    <do text="$Save $all" shortcut="ctrl+s" onclick="flushall()"/>
    <do text="$Delete" shortcut="f8" onclick="eraseobj()"/>
    <separator/>
    <do text="$Quit" onclick="quit()"/>
  </popup>
  <popup text="$Tools">
    <do text="$Generate-font" shortcut="ctrl+alt+f" onclick="generate_font()"/>
    <do text="HTML $database" onclick="makehtml()"/>
    <do text="$Edit-bitmaps" onclick="editbitmaps()"/>
  </popup>
</menubar>
</data>
