module bitmapEditModule;

include module bitmapEditBaseModule;

var form,win;
var rootitems,childitems;

//var dx=0,dy=0;

function run(pic) {
  picture=pic.clone();
  form=new Form();
  form.handler=this;
  win=form.loadWindow("form.bmpedit");
  
  fillcolors(form->colortable);
  changeview();
  
  win.showModal();
  
  form.destroy();
  form=null;
  win=null;
 
  return picture;
}

function paint(cnv) {
  picture.stretch(0,0,picture.W*getbmpscale(),picture.H*getbmpscale(),cnv);
}

function ptolbmpx(p) {
  if (!picture) return 0;
  directly return (p/getbmpscale());
}
function ptolbmpy(p) {
  if (!picture) return 0;
  directly return (p/getbmpscale());
}

function getbmpscale() {
  return 0.01*(1.1).power(form->bmpscale.cur);
}

function changeview() {
//  dx=0;dy=0;
  var w=picture.W*getbmpscale(),h=picture.H*getbmpscale();
//  if (w<form->pp->W*0.9) dx=(form->pp->W-w)/2;
//  if (h<form->pp->H*0.9) dy=(form->pp->H-y)/2;
  form->pp.setInSize(w,h);
  form->pp.repaint();
}

function mdown(x,y,button,shift) {
  x=new Number(x);y=new Number(y);
  picmdown(x,y,button,shift);
}
function mmove(x,y) {
  x=new Number(x);y=new Number(y);
  picmmove(x,y);
}
function mup(x,y,button) {
  x=new Number(x);y=new Number(y);
  picmup(x,y,button);
}

function loadfile() {
  if (var file=OpenDialog.run("*.bmp")) {
    picture.load(file);
    changeview();
  }
}

function savefile() {
  if (var file=SaveDialog.run("*.bmp")) {
    picture.save(file);
  }
}

function newfile() {
  if (Application.runXMLDialog(Application.findResource("poed.newbitmap"),xml)) {
    picture=new Picture();
    picture.W=xml->w;
    picture.H=xml->h;
    changeview();
  }
}

