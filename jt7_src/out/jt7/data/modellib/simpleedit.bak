module simpleEditModule;

include module simpleEditInlinesModule;
include module simpleEditMaterialsModule;
include module simpleEditStampsModule;
include module bitmapEditBaseModule;

var window;
var form;
var dx=0,dy=0,scale=1,scalex=1,scaley=1,scalecur=0;
var ismoving;
var lastmx=0,lastmy=0;
var csize2=4;
var selpt;
var selline;
var ptdist=0;
var movingpt;
var maxdeletedist=5;
var maxmovedist=5;
var jumpx=0.01;
var jumpy=0.01;
//var picture;
var picfile;//soubor, ze ktereho obrazek je
var pichflip,picvflip;//zda byl obraz pretocen
var picmodified=false;
//var bakpicture;
var picx0,picy0;
var picw,pich;
var penpt0;//bod, odkud se kreslilo tuzkou
var rectpt0;//bod, odkud se kreslil obdelnik
var selpt0,selpt1,selecting;//bod, odkud (resp. kam) se kresli obdelnik vyberu
var selpic;//Picture, !=null:obsahuje vybrany picture
var blitpic;//obrazek, ktery se kresli na picture
var blitx,blity,blitw,blith;
var blitpt0;
var blitsizing;
var inlinept0;
var inlinesizing;
var modelview;

var smodel;//model (argument run)
var zipobj;//objekt, ktery se edituje
var curalong;//dite smodel (alongx/alongy/alongz)
var polygon;//polygon, ktery se prave edituje
var colorize;//ukazuje na colordec nebo colorinc

function loadPicture(pic,file) {
  var path=zipobj.getFile(file);
  pic.load(path);
  zipobj.closedGetFile(path,file);
}

function savePicture(pic,file) {
  var path=zipobj.setFile(file);
  pic.save(path);
  zipobj.closedSetFile(path,file);
}

function render() {
  savepic();
  Textures.clear();
  simpleObjectModule.recount(smodel,zipobj);
  modelview.load(smodel-/model,zipobj);
  form->pager.cur=1;
}

function close() {
  if (form->pager.cur>0) form->pager.cur=0;
  else window.close();
}

function run(xml,obj) {
  var opt=Application.options.forceSub("edpoly");
  this.smodel=xml;
  this.zipobj=obj;
  
  form=new Form();
  form.handler=this;
  window=form.loadWindow("model.simpleedfrm");
  modelview=new ModelView(form->modelview);
  curalong=null;
  polygon=null;
  picture=null;
  picmodified=false;
  
  form->along.cur=xml->edit_along;
  
  alongchange();
  colorizechange();
  
  initinlinepage();
  initmaterialpage();
  initstamppage();
  
  updateinlines();
  
  fillcolors(form->colortable);
  form->crookmemo.text=smodel.forceSub("crook").text;  
  var fnt=new Font();fnt.name="Courier New";fnt.size="12";
  form->crookmemo.font=fnt;
  
  window.showModal();
  
  doneinlinepage();
  donematerialpage();
  donestamppage();
  
  saveeditprops();
  savepic();  
  
  xml->edit_along=form->along.cur;

  smodel.forceSub("crook").text=form->crookmemo.text;
  
  form.destroy();
  
  Textures.clear();
  
  modelview.destroy();
  modelview=null;
  xml=null;
  form=null;
  window=null;
}

function ltopx(l) {directly return (l+1)*form->pp.W/2*scalex+dx;}
function ltopy(l) {directly return (1-l)*form->pp.H/2*scaley+dy;}
function ptolx(p) {directly return (p-dx)*2/form->pp.W/scalex-1;}
function ptoly(p) {directly return 1-(p-dy)*2/form->pp.H/scaley;}
function ptolbmpx(p) {if (!picture) return 0;directly return (picture.W*(ptolx(p)-picx0)/picw-0.5).round();}
function ptolbmpy(p) {if (!picture) return 0;directly return (picture.H*(1-(ptoly(p)-picy0)/pich)-0.5).round();}
//function ltopbmpx(l) {if (!picture) return 0;directly return ltopx( (l+0.5)*picw/picture.W+picx0 );}
//function ltopbmpy(l) {if (!picture) return 0;directly return ltopy( ((l+0.5)/picture.H-1)*(0-pich)+picy0 );}

function inl_gettx(xml) {return new Number(xml.getVar(["tz","tx","tx"][form->along.cur]));}
function inl_getty(xml) {return new Number(xml.getVar(["ty","tz","ty"][form->along.cur]));}
function inl_getsx(xml) {return new Number(xml.getVar(["sz","sx","sx"][form->along.cur]));}
function inl_getsy(xml) {return new Number(xml.getVar(["sy","sz","sy"][form->along.cur]));}

function inl_settx(xml,v) {xml.setVar(["tz","tx","tx"][form->along.cur],v);}
function inl_setty(xml,v) {xml.setVar(["ty","tz","ty"][form->along.cur],v);}
function inl_setsx(xml,v) {xml.setVar(["sz","sx","sx"][form->along.cur],v);}
function inl_setsy(xml,v) {xml.setVar(["sy","sz","sy"][form->along.cur],v);}


function selpichflip() {if (selpic) selpic.hflip();}
function selpicvflip() {if (selpic) selpic.vflip();}

function selresize() {
  if (selpic) {
    var data=new XMLNode();
    data->x=100;data->y=100;
    if (Application.runXMLDialog(Application.findResource("model.selresizefrm"),data)) {
      var p2=new Picture();
      directly p2.W=selpic.W*data->x/100;
      directly p2.H=selpic.H*data->y/100;
      selpic.stretch(0,0,p2.W,p2.H,p2.canvas);
      selpic=p2;
    }
  }
}
function selpicvflip() {if (selpic) selpic.vflip();}

function updateinlines() {
  var items=smodel.forceSub("inlines").childs.join({value->name&"("&value->comment&")"},"\n");
  form->inlinelist.items=items;
  form->inlines.items=items;
}

function actinline() {
  if (form->inlines.cur>=0) return smodel-/inlines[form->inlines.cur];
  return null;
}

function changeinline() {
  changeview();
}

function copybmp() {
  var a=selpt0,b=selpt1;
  if (selpt0 && selpt1 && b->x>=a->x && b->y>=a->y) {
    undrawselect();
    selpic=new Picture();
    selpic.W=b->x-a->x+1;
    selpic.H=b->y-a->y+1;
    picture.stretchRectangle(0,0,selpic.W,selpic.H,a->x,a->y,selpic.W,selpic.H,selpic.canvas);
    changeview();
  } else Window.alert("$Nothing-is-selected");
}

function loadbmp() {
  var o=new OpenDialog();
  o.initialDir=File.root/"data"/"textures";
  o.filter="$Bitmaps|*.bmp";
  if (o.execute()) {
    selpic=new Picture();
    selpic.load(o.file);
  }
}

function colorizechange() {
  savepic();
  colorize=null;picture=null;bakpicture=null;
  if (!curalong) return;
  var cur=["colorinc","colordec"][form->colorize.cur];
  if (curalong.isSub(cur)) colorize=curalong.getSub(cur);
  actpic();
}

function togglenextpolygon() {
  nextpolygon();
  changeview();
}

function nextpolygon() {
  var last=polygon;
  polygon=null;
  if (!curalong) return;
  var clip=curalong-/clip;
  if (clip.count==0) return;
  if (!last) {polygon=clip[0];return;}
  var idx=-1;
  for(var i=0;i<clip.count;i++) if (clip[i]==last) idx=i;
  idx++;
  if (idx>=clip.count) idx=0;
  polygon=clip[idx];
}

function addpoly() {
  if (!curalong) return;
  var clip=curalong-/clip;
  polygon=clip.add();polygon.name="polygon";
  clearpolygon();
}

function erasepoly() {
  if (polygon) {
    polygon.remove();
    polygon=null;
    nextpolygon();
    changeview();
  }
}

function clearpolygon() {
  if (!polygon) return;
  selpt=null;selline=null;
  polygon.clearSubs();
  addpt(0,0);addpt(0,1);addpt(1,1);addpt(1,0);
  changeview();
}


function alongchange() {
  savepic();
  saveeditprops();
  curalong=smodel.getSub( ["alongx","alongy","alongz"] [form->along.cur] );
  polygon=null;
  nextpolygon();
  loadeditprops();
  colorizechange();
  changeview();
}

function roundx(x) {
  if (jumpx>0) directly return ((x/jumpx).round())*jumpx;
  return new Number(x);
}
function roundy(y) {
  if (jumpy>0) directly return ((y/jumpy).round())*jumpy;
  return new Number(y);
}

function savepic() {
  if (picmodified && picture) {
    undrawselect();
    if (picvflip) picture.vflip();
    if (pichflip) picture.hflip();
    savePicture(picture,picfile);
//    picture.save(picfile);
  }
}

function actpic() {
  savepic();
  var xml=colorize;
  picture=null;bakpicture=null;picmodified=false;
  if (!xml) return;
  var file=Textures.textureFile(xml->texture);
//  var file=xml->texture;
//  if (file && file.isFile()) {
  if (file!="") {
    picfile=file;pichflip=false;picvflip=false;
    picture=new Picture();
    loadPicture(picture,file);
//    picture.load(file);
    var x1=new Number(xml->texx1);
    var x2=new Number(xml->texx2);
    var y1=new Number(xml->texy1);
    var y2=new Number(xml->texy2);
    if (x1>x2) {pichflip=true;picture.hflip();}
    if (y1>y2) {picvflip=true;picture.vflip();}
    picx0=x1;if (x2<picx0) picx0=x2;
    picy0=y1;if (y2<picy0) picy0=y2;
    picw=(x1-x2).abs();
    pich=(y1-y2).abs();
    bakpicture=picture.clone();
  }
}

