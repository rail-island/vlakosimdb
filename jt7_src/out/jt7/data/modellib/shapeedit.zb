module shapeEditModule;

class ShapeEditor extends XMLEditor {
  var modv;
  var myform;
  var zip;
  constructor (xml,myform,zip) {
    this.myform=myform;
    this.zip=zip;
    init(xml,myform->xmledit,myform);
    modv=new ModelView(myform->glv,myform);
    myform.handler=this;
    review();
  }
  function review() {
    modv.load(doc,zip);
  }
  function onchange() {
    review();
  }
  function edit() {
    if (var sel=selected()) {
      savevars();
      if (sel->scriptname!="") {
        modelScripts.editscript(sel);
      }
      loadvars();
    }
  }
  function runscript() {
    savevars();
    modelScripts.runscriptdialog(selected());
    loadvars();
  }
  function insdata(type) {
    if (var sel=selected()) {
      var xml=sel.add();
      xml.assign(Application.findResource("shapeedit."&type));
      xml.eraseVar("rep.name");
      updatetree();
    }
  }
  
}

function run(xml,obj) {
  var form=new Form();
  var win=form.loadWindow("form.shapeeditor");
  var editor=new ShapeEditor(xml,form,obj);
  win.showModal();
}
