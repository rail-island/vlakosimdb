module buildingModule;

requires module poedTypes;

var zipobj;
var xml;
var type="building";
var form;
var place;
readonly resname="poed.bldfrm";
readonly hasdata=true;
var actmodel;

function creating(xml) {return poedTypes.nameDialog(type,xml);}
function created(xml,obj) {}

function edit(xml,obj) {
  poedTypes.editChild("model.zip",obj);
}

function loaded(xml,obj,panel,form) {
  form.handler=this;
  this.zipobj=obj;this.xml=xml;
  this.form=form;
  updatemodels();
  place=form->bldplace;
}
function unload(index,obj) {}

function updatemodels() {
  form->models.items=xml-/models.childs.join({value->model},"\n");
}
function modelchange() {
  saveactmodel();
  actmodel=xml-/models.childs[form->models.cur];
  loadactmodel();
}
function erasemodel() {
  if (actmodel) {
    actmodel.remove();
    actmodel=null;
    updatemodels();
  }
}
function addmodel() {
  var x=xml.forceSub("models").add("model");
  x->model="none";
  updatemodels();
}
function saveactmodel() {
  if (actmodel) {
    place.saveData(actmodel);
  }
}
function loadactmodel() {
  if (actmodel) {
    place.loadData(actmodel);
  }
}
function browsemodel() {
  if (var newmodel=includeDialogModule.run(zipobj,form->modeledit.text)) form->modeledit.text=newmodel;
}
function savedata(index,obj) {
  saveactmodel();
}


poedTypes.addType("building",this);

