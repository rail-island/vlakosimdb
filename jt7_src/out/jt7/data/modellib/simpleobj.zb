function makecrook(crook,model) {
  for (cr in crook.text.split("\n")) {
    cr=cr.trim();
    if (cr.length==0) continue;
    if (cr[0]==';') continue;
//    xml-/model.save(File.root/"beforecrook.xml");
    ModelProcs.crook(model,cr);
//    xml-/model.save(File.root/"crook.xml");
  }
}

function insertinlines(xml,when,zipobj) {
  for (inl in xml-/inlines) if (inl->when==when) {
    if (inl->what=="1") {//odkaz
      var i=xml-/model.add();
      i.name="inline";
      i->name=inl->name;
      i->sx=inl->sx;i->sy=inl->sy;i->sz=inl->sz;
      i->tx=inl->tx;i->ty=inl->ty;i->tz=inl->tz;
      i.forceSub("args").assign(inl-/args);
    } else {//vlozeni
      var obj=zipobj.openChildPath(inl->name);
      var tmp=new XMLNode();
      obj.loadXML("index.xml",tmp);
      if (tmp->"glomodel.loadchild"!="") tmp=tmp.getSub(tmp->"glomodel.loadchild");
      ModelProcs.scale(tmp,inl->sx,inl->sy,inl->sz);
      ModelProcs.translate(tmp,inl->tx,inl->ty,inl->tz);
      for (t in tmp) xml-/model.add().assign(t);
    }
  }
}

function findalong(xml,name) {
  var along=xml.getSub("along"+name);
  if (along->sameas!="") return xml.getSub("along"+along->sameas);
  return along;
}

function recount(xml,zipobj) {

  var alongx=findalong(xml,"x");
  var alongy=findalong(xml,"y");
  var alongz=findalong(xml,"z");

  var model=xml.forceSub("model");
  model.clearSubs();

  for (shape in xml-/shapes) {
    var pedr=new PedrAlg();
    var areclips=false;
    if (makeclips(shape->name,alongx-/clip,pedr,0)) areclips=true;
    if (makeclips(shape->name,alongy-/clip,pedr,1)) areclips=true;
    if (makeclips(shape->name,alongz-/clip,pedr,2)) areclips=true;
    var mod=new XMLNode();
    select (shape->type) {
      "clip":pedr.run(mod);
      "rotate":{
        ModelProcs.generateRotateSolid(shape-/verteces,mod,shape->rotateverteces,shape-/colorizes);
        if (shape->cullsafe=="1") {
          for (p in mod) p->culling="0";
        }
        if (areclips) {
          var mout=new XMLNode();
          pedr.modifyRun(mod,mout);
          mod=mout;
        }
      }
    }
    makecrook(xml-/crook,mod);
    ModelProcs.polyedrToPolygons(mod,mod);
    for (x in mod) model.add().assign(x);
  }

  var calg=new ColorAlg();
  
  for (cize in xml-/colorizes) {
    var diridx=0;
    for (dirbool in cize->dirs.split(";")) {
      var mat=cize->material=="1",st=cize->stamp=="1";
      if (dirbool=="1") {
        if (!st && mat) {
          calg.addMaterialSide(diridx,cize->dx,cize->dy,cize->xscale,cize->yscale,cize->texture,cize->transparent=="1",
          cize->rkoef==""?"1":cize->rkoef,cize->gkoef==""?"1":cize->gkoef,cize->bkoef==""?"1":cize->bkoef,cize->transp=="1",cize->cond,cize->denylight=="1");
        }
        if (!st && !mat) {
          calg.addSide(diridx,cize->texx1,cize->texy1,cize->texx2,cize->texy2,cize->texture,cize->transparent=="1",cize->cond,cize->rkoef==""?"1":cize->rkoef,cize->gkoef==""?"1":cize->gkoef,cize->bkoef==""?"1":cize->bkoef,cize->denylight=="1");
        }
      }
      diridx++;
    }
  }

//  insertinlines(xml,"beforecolor");
  insertinlines(xml,"0",zipobj);
  
  for (face in model) calg.run(face);
  
  var newpolys=new XMLNode();

  for (stamp in xml-/colorizes) if (stamp->stamp=="1") {
    var xcnt=new Number(stamp->stampcntx),ycnt=new Number(stamp->stampcnty);
    var xsp=new Number(stamp->stampspacex),ysp=new Number(stamp->stampspacey);
    if (xcnt<1) xcnt=1;if (ycnt<1) ycnt=1;
    
    option directly;
    var elemwi=(stamp->texx2-stamp->texx1-(xcnt-1)*xsp)/xcnt;
    var elemhi=(stamp->texy2-stamp->texy1-(ycnt-1)*ysp)/ycnt;
    option indirectly;

    var stalg=new StampAlg();
    stalg.texture=stamp->texture;
    stalg.material=stamp->material=="1";
    stalg.xscale=stamp->xscale;
    stalg.yscale=stamp->yscale;
    stalg.condition=stamp->cond;
    stalg.dist=stamp->stampdist;
    if (stamp->rkoef!="") stalg.rkoef=stamp->rkoef;
    if (stamp->gkoef!="") stalg.gkoef=stamp->gkoef;
    if (stamp->bkoef!="") stalg.bkoef=stamp->bkoef;
    
    for (var x=0;x<xcnt;x++) for (var y=0;y<ycnt;y++) {
      option directly;
      stalg.x1=stamp->texx1+(elemwi+xsp)*x;
      stalg.y1=stamp->texy1+(elemhi+ysp)*y;
      stalg.x2=stalg.x1+elemwi;
      stalg.y2=stalg.y1+elemhi;
//      Window.alert(xcnt,elemwi,stalg.x1,stalg.y1,stalg.x2,stalg.y2);
      option indirectly;
      var dir=0;
      for (ds in stamp->dirs.split(";")) {
        if (ds=="1") {
          stalg.dir=dir;
          for (face in model) stalg.run(face,newpolys);
        }
        dir++;
      }
    }
  }


/*  
  for (stamp in xml-/stamps) {
    var stalg=new StampAlg();
    stalg.texture=stamp->texture;
    stalg.x1=stamp->x1;
    stalg.y1=stamp->y1;
    stalg.x2=stamp->x2;
    stalg.y2=stamp->y2;
    var dir=0;
    for (ds in stamp->dirs.split(";")) {
      if (ds=="1") {
        stalg.dir=dir;
        for (face in model) stalg.run(face,newpolys);
      }
      dir++;
    }
  }
*/  
  
  for (p in newpolys) model.add().assign(p);

  var erase=xml->deletefaces.split(";");

  for (var i=0;i<model.count;i) {
    var p=model[i];
    if (erase.searchString(p->faceid)>=0) p.remove();else i++;
  }
  
//  insertinlines(xml,"");
  insertinlines(xml,"1",zipobj);
  
  var noisefiles=new Store();
  
  for (noise in xml-/noise) {
    for (file in noise->files.split(";")) {
      var nf=noisefiles[file];
      if (!nf) {
        nf=noisefiles[file]=new XMLNode();
        nf.name="description";
      }
      var x=nf.forceSub("filter").forceSub("noise").add("noise");
      x->per_r=noise->dr;
      x->per_g=noise->dg;
      x->per_b=noise->db;
      x->srccolor=noise->srccolor;
    }
  }
  
  for (f in zipobj.listFiles().split("\n")) {
    var file=new File(f);
    if (file.hasExt("xds")) zipobj.removeFile(file);
  }  
  
  for (file in noisefiles) {
    var f=new File(file)%"xds";
    zipobj.saveXML(f,noisefiles[file]);
  }
  
}

function newtexture(w,h,name,obj)  {
  var p=new Picture();
  p.W=w;
  p.H=h;
  var path=obj.setFile(name);
  p.save(path);
  obj.closedSetFile(path,name);
//  p.save(File.root/"data"/"textures"/name);
}

function newtexturexml(data,name,dirs,imgname,xml,x,y,w,h)  {
  option directly;
  xml.name="colorize";
  xml->texture="pack:"&name&"_"&imgname&".bmp";
  xml->dirs=dirs;
  xml->texx1=x;xml->texy1=y;
  xml->texx2=x+w;xml->texy2=y+h;
}

function newalong(data,xml,name,w,h,x,y,tex,obj,cizes,clips) {
  xml.name="along"+name;
  xml->edit_jumpx=0.1;
  xml->edit_jumpy=0.1;
  xml->edit_scale=25;
  xml->edit_dx=300;
  xml->edit_dy=200;
  
  var clip=xml.add();clip.name="clip";
  if (x=="") directly x=0-w/2;
  if (y=="") directly y=0-h/2;
  
  option directly;
  
  if (clips && !(clips is String)) {
    for (interval in clips) {
      var p=clip.add();p.name="polygon";
      p->apply="base";
      
      option directly;
      addpt(p,x+interval[0],y);
      addpt(p,x+interval[1],y);
      addpt(p,x+interval[1],y+h);
      addpt(p,x+interval[0],y+h);
    }
  } else {
    var p=clip.add();p.name="polygon";
    p->apply="base";
    
    option directly;
    addpt(p,x,y);
    addpt(p,x+w,y);
    addpt(p,x+w,y+h);
    addpt(p,x,y+h);
  }
  var cinc=false,cdec=false,cboth=false;
  
  select (tex) {
    0:cinc=true;
    1:cdec=true;
    2:cboth=true;
    3:{cinc=true;cdec=true;}
  }
  
  var k=data->texdetail;
  
  var incname,decname;
  
  if (cinc) newtexture(w*k,h*k,name&"_inc"&".bmp",obj);
  if (cdec) newtexture(w*k,h*k,name&"_dec"&".bmp",obj);
  if (cboth) newtexture(w*k,h*k,name&"_both"&".bmp",obj);
  
  var pre_dirs=new (x="",y="0;0;",z="0;0;0;0;");
  var post_dirs=new (x="0;0;0;0;",y="0;0;",z="");
  
  select (tex) {
    0:newtexturexml(data,name,pre_dirs[name]&"1;0;"&post_dirs[name],"inc",cizes.add(),x,y,w,h);
    1:newtexturexml(data,name,pre_dirs[name]&"0;1;"&post_dirs[name],"dec",cizes.add(),x,y,w,h);
    2:newtexturexml(data,name,pre_dirs[name]&"1;1;"&post_dirs[name],"both",cizes.add(),x,y,w,h);
    3:{
      newtexturexml(data,name,pre_dirs[name]&"1;0;"&post_dirs[name],"inc",cizes.add(),x,y,w,h);
      newtexturexml(data,name,pre_dirs[name]&"0;1;"&post_dirs[name],"dec",cizes.add(),x,y,w,h);
    }
  }

/*  
  var ninc,ndec;
  select (tex) {
    0:ninc="inc";
    1:ndec="dec";
    2:ninc=ndec="both";
    3:{ninc="inc";ndec="dec";}
  }

  var pre_dirs=new (x="",y="0;0;",z="0;0;0;0;");
  var post_dirs=new (x="0;0;0;0;",y="0;0;",z="");

  if (ninc) newtexturexml(data,name,pre_dirs[name]&"1;0;"&post_dirs[name],ninc,cizes.add(),x,y,w,h);
  if (ndec) newtexturexml(data,name,pre_dirs[name]&"0;1;"&post_dirs[name],ndec,cizes.add(),x,y,w,h);
*/  
}

var tmpdata;

function creating(xml) {
  tmpdata=null;
  var data=new XMLNode();
/*  
  data->xsize=16;data->ysize=5;data->zsize=3;data->name="model";
  data->x0=0;data->y0=0;data->z0="";//z:centrovane
  data->texx=2;data->texy=1;data->texz=2;
  data->texdetail=10;data->treemodel="0";
*/  
  data->xsize=10;data->ysize=10;data->zsize=10;data->name="model";
  data->x0=0;data->y0=0;data->z0=0;//z:centrovane
  data->texx=2;data->texy=1;data->texz=2;
  data->texdetail=10;
  
  if (Application.runXMLDialog(Application.findResource("model.inssimplemodelform"),data)) {
    xml->name=data->name;
    tmpdata=data;
    return true;
  }
  return false;
}

function createSimpleObject(data,xml,obj) {
  var istree=data->treemodel=="1";
  xml->xsize=data->xsize;xml->ysize=data->ysize;xml->zsize=data->zsize;
  xml.name="simplemodel";
  xml->version="1.0";
  xml->"glomodel.loadchild"="model";
  xml->name=data->name;
  xml.forceSub("colorizes");
  newalong(data,xml.add(),"x",data->zsize,data->ysize,data->z0,data->y0,data->texx,obj,xml-/colorizes,data->xclips);
  newalong(data,xml.add(),"y",data->xsize,data->zsize,data->x0,data->z0,data->texy,obj,xml-/colorizes,data->yclips);
  if (istree) {
    newalong(data,xml.add(),"z",data->xsize,data->ysize,data->x0,data->y0,data->texz,obj,xml-/colorizes,data->zclips);
    xml-/alongz->sameas="x";
  } else {
    newalong(data,xml.add(),"z",data->xsize,data->ysize,data->x0,data->y0,data->texz,obj,xml-/colorizes,data->zclips);
  }
  xml.forceSub("inlines");
  xml.forceSub("crook");
  var shape=xml.add("shapes").add("shape");
  shape->name="base";shape->type="clip";
  var md=xml.forceSub("model");
}

function created(xml,obj) {
  createSimpleObject(tmpdata,xml,obj);
  tmpdata=null;
}

function conv0to1_along(main,xml) {
  for (p in xml-/clip) {
    p->apply="base";
  }
}


function __set_colors(it,cize) {
  it->texture=cize->texture;
  it->texx1=cize->texx1;
  it->texy1=cize->texy1;
  it->texx2=cize->texx2;
  it->texy2=cize->texy2;
}

function addalong_colors(cize,along,dbef,daft) {
  if (along-/colordec->texture==along-/colorinc->texture && along-/colorinc->texture!="") {
    var it=cize.add("colorize");
    it->dirs=dbef&"1;1;"&daft;
    __set_colors(it,along-/colordec);
  } else {
    if (along.isSub("colorinc")) {
      var it=cize.add("colorize");
      it->dirs=dbef&"1;0;"&daft;
      __set_colors(it,along-/colorinc);
    }
    if (along.isSub("colordec")) {
      var it=cize.add("colorize");
      it->dirs=dbef&"0;1;"&daft;
      __set_colors(it,along-/colordec);
    }
  }
  along.eraseSub("colordec");
  along.eraseSub("colorinc");
}

function conv0to1(xml) {
  conv0to1_along(xml,xml-/alongx);
  conv0to1_along(xml,xml-/alongy);
  conv0to1_along(xml,xml-/alongz);
  
  var cize=xml.forceSub("colorizes");
  
  for (mat in xml-/materials) {
    var it=cize.add("colorize");
    it->dirs=mat->dirs;
    it->xscale=mat->xscale;
    it->yscale=mat->yscale;
    it->texture=mat->texture;
    it->transp=mat->transp;
    it->transparent=mat->transparent;
    it->material="1";
  }
  
  addalong_colors(cize,xml-/alongx,"","0;0;0;0");
  addalong_colors(cize,xml-/alongy,"0;0;","0;0");
  addalong_colors(cize,xml-/alongz,"0;0;0;0;","");
 
  for (st in xml-/stamps) {
    var it=cize.add("colorize");
    it->dirs=st->dirs;
    it->texture=st->texture;
    it->stamp="1";
    it->texx1=st->x1;
    it->texy1=st->y1;
    it->texx2=st->x2;
    it->texy2=st->y2;
  }
  var shapes=xml.forceSub("shapes");
  var base=shapes.add("shape");
  base->name="base";
  base->type="clip";
  
  xml.eraseSub("stamps");
  xml.eraseSub("materials");
   
  xml->version="1.0";
}

function convertversion(xml) {
  var ver=new Number(xml->version);
  if (ver<1.0) {
    if (ver>=0.0) conv0to1(xml);
  }
}

function edit(xml,obj) {
  convertversion(xml);
  simpleEditModule.run(xml,obj);
}
function loaded(xml,obj,panel,form) {
  var modv=new ModelView(form->glv,form);
  modv.load(xml,obj);
}
function unload(index,obj) {
}
function savedata(index,obj) {
}
readonly resname="poed.simplemodelfrm";
readonly hasdata=false;


poedTypes.addType("simplemodel",this);
