module simpleObjectModule;

requires module poedTypes;

function addpt(xml,x,y) {
  var pt=xml.add();pt.name="point";
  pt->x=x;pt->y=y;
}

function makeclips(name,clip,pedr,dir) {
  var res=false;
  for (x in clip) {
    var names=x->apply.split(";");
    if (names.searchString(name)>=0) {
      pedr.clip(dir,x);
      res=true;
    }
  }
  return res;
}

/*
function makecolor(along,dir0,calg) {
  if (along.isSub("colorinc")) calg.setSide(dir0,along-/colorinc->texx1,along-/colorinc->texy1,
		  along-/colorinc->texx2,along-/colorinc->texy2,along-/colorinc->texture,along-/colorinc->transparent=="1");
  if (along.isSub("colordec")) calg.setSide(dir0+1,along-/colordec->texx1,along-/colordec->texy1,
		  along-/colordec->texx2,along-/colordec->texy2,along-/colordec->texture,along-/colordec->transparent=="1");
}
