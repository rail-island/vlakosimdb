includable module simpleEditShapesModule;

var actshape;

function saveactshape() {
  if (actshape) {
    form->shapepage.saveData(actshape);
  }
}

function initshapepage() {
  actshape=null;
  updateshapes();
  changerotateverteces();
}

function loadactshape() {
  if (actshape) {
    form->shapepage.loadData(actshape);
    changerotateverteces();
  }
}

function doneshapepage() {
  saveactshape();
  actinl=null;
}

function changedshapelist() {
  saveactshape();
  actshape=smodel-/shapes[form->shapelist.cur];
  loadactshape();
}

function testuniqueshapename(name) {
  if (smodel-/shapes.childs.searchIf({value->name==name})) {
    Window.alert("$Shape-allready-exists:"&name);
    return false;
  }
  return true;
}

function addshape() {
  if (var name=Window.inputBox("POEdit","$Insert-unique-shape-name","noname")) {
    if (testuniqueshapename(name)) {
      var xml=smodel-/shapes.add("shape");
      xml->type="clip";
      xml->name=name;
      updateshapes();
    }
  }
}

function renameshape() {
  if (actshape) {
    if (var name=Window.inputBox("POEdit","$Insert-unique-shape-name",actshape->name)) {
      if (testuniqueshapename(name)) {
        actshape->name=name;
        updateshapes();
      }
    }
  }
}

function changerotateverteces() {
  form->rotatevertecescaption.text="$Verteces-number="&form->rotateverteces.cur;
}

function updateshapes() {
  var cur=form->shapelist.cur;
  var items=smodel-/shapes.childs.join({value->name},"\n");
  form->shapelist.items=items;
  form->shapelist.cur=cur;
  form->shapes.items=items;
}

function eraseshape() {
  if (actshape) {
    actshape.remove();
    actshape=null;
    updateshapes();
  }
}

function editrotate() {
  if (actshape) rotateColorizeModule.run(actshape.forceSub("colorizes"),zipobj);
}
