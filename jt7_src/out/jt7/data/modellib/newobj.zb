module newObjectModule;

var form,win;
//var result;
var tpldirs;
var tpls;
var curtpldir;
var parobj;
var result;
var tplfile;

var skeleton_names=["loco","simplemodel","shape3d","semaphore","building","tunnel","rstation","bridge","trees"];
var skeleton_titles=["$Railroad-vehicle","$Simple-model","$Shape3d","$Semaphore","$Building","$Tunnel","$Railway-station","$Bridge","$Trees"];

