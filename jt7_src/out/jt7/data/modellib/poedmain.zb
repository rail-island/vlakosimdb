function changedpath() {
  var res="";
  var act=actobj;
  if (act) res=act.name;else res="???";
  act=parobj;
  while (act) {
    res=act.name&"/"&res;
    act=act.parent;
  }    
  form->path.text=res;
}
function flushall() {
  directory.flush();
}
function edit() {
  if (actobj) {
    saveactnoclose();
    poedTypes.edit(index,actobj);
    loadact();
  }
}
function editxml() {
  if (actobj) {
    saveactnoclose();
    XMLEditModule.run(index);
    loadact();
  }
}
function eraseobj() {
  if (actobj) {
    actobj.remove();
    actobj=null;
    listchanged();
    changedpath();
  }
}
function onidle() {
  poedTypes.makeIdle();
  smokeEditModule.makeIdle();
}
function makehtml() {
  HTMLExportModule.run(directory);
}

function newobject() {
  if (newObjectModule.run(parobj)) {
    saveact();
    directory.flush();
    listchanged();
    actobj=null;
    loadact();
  }
/*
  if (var type=newObjectModule.run()) {
    if (var newobj=type.create(parobj)) {
      saveact();
      directory.flush();
      listchanged();
      actobj=null;
      loadact();
    }
  }
*/
}

function storetorepositary() {
  if (actobj) {
    var path=actobj.parent.getFile(actobj.name);
    var dir=File.root/"data"/"templates"/index.name;
    dir.mkdirs();
    
    if (var name=Window.inputBox("$Question","$Name",(new File(actobj.name))%"")) {
      var file=dir/(name&".zip");
      if (file.isFile()) {
        if (Window.msgwin("POEdit","$Overwrite-prompt","$Yes;$No")!=0) return;
      }
      directory.flush();
      (new File(path)).copyTo(file);
      var xml=new XMLNode();
      var po=new PersistentObject(file);
      po.loadXML("index.xml",xml);
      xml->name=name;
      po.saveXML("index.xml",xml);
      po.flush();
    }
  }
}

function edittcomment() {
  if (!actobj) return;
  if (var lid=Window.inputBox("$Question","lang-id","en")) {
    var text="";
    if (actobj.hasFile("tcomment."&lid)) text=actobj.loadText("tcomment."&lid);
    if (var newtext=winTools.editText(text)) {
      actobj.saveText("tcomment."&lid,newtext);
    }
  }
}

Application.addSearchPath(File.root/"data"/"bmps");
Application.title="POEdit";
  
form=new Form();
win=form.loadWindow("poed.mainwin");
form.handler=this;

listchanged();
win.show();


panel=form->objpanel;

Application.onIdle="onidle()";
Application.handler=this;
Application.run();

directory.flush();
