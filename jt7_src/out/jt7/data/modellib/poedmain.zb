program module poedMain;

var form,win;
var directory=new PersistentObject(File.root/"objects");
var parobj=directory;//parent obj
var actobj=null;
var index=new XMLNode();
var actform=null;
//var resnames=new ("loco"="poed.locofrm","shape3d"="poed.shape3dfrm","simplemodel"="poed.simplemodelfrm","semaphore"="poed.semfrm");
//var hasdata=["loco","semaphore"];
var panel;
//var objstack=[directory];
var curlist=[];//childs currectly visible

function saveactnoclose() {
  if (poedTypes.hasdata(index)) panel.saveData(index);
  poedTypes.savedata(index,actobj);  
  actobj.saveXML("index.xml",index);
}

function editbitmaps() {
  if (actobj) editBitmapsModule.run(actobj);
}

function generate_font() {
  makeFontModule.run();
}

function saveact() {
  if (actobj) {
    saveactnoclose();
  }
  actobj=null;
}

function delform() {
  if (actform) actform.destroy();
  actform=new Form();
}

function loadobj(obj) {
  if (actobj) poedTypes.unload(index,actobj);
  index=new XMLNode();
  obj.loadXML("index.xml",index);
  delform();
  panel.clearChilds();
//  var resname=resnames[index.name];
  if (var resname=poedTypes.resname(index)) panel.loadProps(Application.findResource(resname),actform);
  if (poedTypes.hasdata(index)) panel.loadData(index);
  poedTypes.loaded(index,actobj,panel,actform);
}

function loadact() {
  saveact();
//  if (var name=parobj.listChilds().split("\n")[form->objelems.cur]) {
  if (var name=curlist[form->objelems.cur]) {
    actobj=parobj.openChild(name);
    loadobj(actobj);
  }
  changedpath();
}

function onclose() {
  saveact();
}

function changedobj() {
  loadact();
}

function btok() {
  saveact();loadact();
}
function btcancel() {
  if (actobj) actobj=null;
  loadact();
}
function btin() {
  if (actobj) {
//    objstack.push(actobj);
    parobj=actobj;
    saveactnoclose();
    actobj=null;
    delform();
    listchanged();
    changedpath();
  }
}
function btout() {
  if (var p=parobj.parent) {
    saveact();
    parobj=p;
    delform();
//    objstack.pop();
    listchanged();
    changedpath();
  }
}
function filterchanged() {
  listchanged();
}
function listchanged() {
  curlist=[];
  var flt;
  var types=form->filter.tag.split(";");
  if (form->filter.cur>0) {
    flt=types[form->filter.cur];
    if (flt=="all") flt=null;
  }
  var array=parobj.listChilds().split("\n");
  for (f in array) {
    if (flt) {
      var child=parobj.openChild(f);
      var xml=new XMLNode();
      child.loadXML("index.xml",xml);
      if (xml.name==flt) curlist.push(f);
      else if (flt=="other" && types.searchString(xml.name)<0) curlist.push(f);
    } else curlist.push(f);
  }
  curlist.sort();
  form->objelems.items=curlist;
}
function quit() {
  Application.exit();
}
