module HTMLExportModule;

var parent;

var locosxml;
var deposxml;
var bridgesxml;
var rstsxml;
var semsxml;
var tunnelsxml;
var treesxml;
var bldsxml;
var motosxml;

var collections;

var outdir;

function exportloco(pxml,child,xml,zipname) {
  var a=pxml.add();
  a.assign(xml);
  
  if (child.hasFile("image.bmp")) {
    a->image=(new File(zipname))%"bmp";
    var path=child.getFile("image.bmp");
    (new File(path)).copyTo(outdir/a->image);
    child.closedGetFile(path,"image.bmp");
  }
  
  var modelchild=child.openChild("model.zip");
  var modelxml=new XMLNode();
  modelchild.loadXML("index.xml",modelxml);
  var model=new Model();
  model.load(modelxml,modelchild);
  model.saveToVRML(outdir/xml->name%"wrz");
  (File.root/"objects"/zipname).copyTo(outdir/zipname);
  a->zipname=zipname;
}

function run(parent) {
//  outdir=File.root/"help"/"objectdb"/"data";
  outdir=File.root/"objectdb";
  outdir.mkdirs();

  var wait=new WaitWindow();
  wait.msg="$Exporting...";
  wait.show();

  locosxml=new XMLNode();
  motosxml=new XMLNode();
  deposxml=new XMLNode();
  bridgesxml=new XMLNode();
  rstsxml=new XMLNode();
  semsxml=new XMLNode();
  tunnelsxml=new XMLNode();
  treesxml=new XMLNode();
  bldsxml=new XMLNode();
  
  collections=new ("depo"=deposxml,"bridge"=bridgesxml,"rstation"=rstsxml,"semaphore"=semsxml,"tunnel"=tunnelsxml,"trees"=treesxml,"building"=bldsxml);
  
  this.parent=parent;
  for (childname in parent.listChilds().split("\n")) {
    var child=parent.openChild(childname);
    var xml=new XMLNode();
    child.loadXML("index.xml",xml);
    var res;
    select (xml.name) {
      "loco":res=exportloco(locosxml,child,xml,childname);
      "motocar":res=exportloco(motosxml,child,xml,childname);
      else {
        if (var col=collections[xml.name]) {
          res=col.add();
          res.assign(xml);
        }
      }
    }
    if (res) {
      res->zipname=childname;
      (File.root/"objects"/childname).copyTo(outdir/childname);
    }
    
  }
  
  var cm=new CharMixer();
  cm.compileFile(File.root/"data"/"htmlexport"/"main.cm");
  cm->locos=locosxml;
  cm->depos=deposxml;
  cm->bridges=bridgesxml;
  cm->rsts=rstsxml;
  cm->tunnels=tunnelsxml;
  cm->sems=semsxml;
  cm->trees=treesxml;
  cm->blds=bldsxml;
  cm->motos=motosxml;
  
  cm->outputdir=outdir;
  
  cm.run();
  
  wait.destroy();
  
  Window.alert("$Export-done-msg "&outdir/"index.html"&"\n"&
  "$edit-export-msg "&File.root/"data"/"htmlexport"/"main.cm");
}

