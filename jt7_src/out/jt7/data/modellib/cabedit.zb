module cabEditModule;

var form,win;
var zipobj;
var cab;

function run(xml,obj) {
  if (win) return;
  
  Textures.clear();
  
  this.zipobj=obj;
  cab=jtObject.load(zipobj);
  
  form=new Form();
  win=form.loadWindow("form.cabeditor");
  form.handler=this;
  
  win.showModal();
  
  form.destroy();
  form=null;
  win=null;
}

function quit() {
  win.close();
}

function paint() {
  var xml=new XMLNode();
  form->speedlabel.text=form->speed.cur;
  xml->speed=form->speed.cur;
  cab.render(form->glview.renderContext,xml);
}

function repaint() {
  form->glview.render();
}

function onsize() {
  var w=form->glv.W,h=form->glv.H;
  if (w*0.75>h) {
    form->glview.W=h/0.75;
    form->glview.H=h;
  } else {
    form->glview.W=w;
    form->glview.H=w*0.75;
  }
}

function mdown(x,y,button) {
}

function mmove(x,y) {
  x=new Number(x);
  y=new Number(y);
  var glx=x/form->glview.W*2-1;
  var gly=-y/form->glview.H*2+1;
  var sx=new String(glx);
  var sy=new String(gly);
  form->coords.text="X="&sx.substr(0,5)&";Y="&sy.substr(0,5);
}

function mup(button) {
}
