.env
*.png
*.obj
*.glb
*.pyc
__pycache__/
.DS_Store

# AI texture remaster pipeline: ignore the debug tree, but track the per-texture
# _4x.png results written next to the sources in db/ (re-include overrides *.png
# above). atlas_4x.png is a DERIVED artifact (built in-memory from the *_4x.png by
# the export), so keep it untracked even though it matches the _4x.png re-include.
generated/
!db/**/*_4x.png
db/**/atlas_4x.png

node_modules/
# Output of `npm run export` (GLB + thumbnails + meta per tree). Rail Island's
# import copies it into its own repository, which is where it is committed.
export/
